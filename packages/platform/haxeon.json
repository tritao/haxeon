{
  "version": 1,
  "package": {
    "name": "haxeon-platform"
  },
  "sourceRoots": [
    "src"
  ],
  "scopeSourceRoots": false,
  "ffi": {
    "interfaces": [
      "bindings/nativekit.hxi",
      "bindings/nativekit-net.hxi",
      "bindings/nativekit-vulkan.hxi"
    ],
    "wasmInterfaces": ["bindings/nativekit-wasm.hxi", "bindings/nativekit-net-wasm.hxi"],
    "projections": [
      "bindings/nativekit.hxmap",
      "bindings/nativekit-net.hxmap",
      "bindings/nativekit-vulkan.hxmap"
    ]
  },
  "publish": {
    "exclude": [
      "tests",
      "tools",
      "docs"
    ]
  },
  "target": "host",
  "dependencies": {
    "haxeon-nativekit": {
      "path": "../nativekit"
    }
  }
}
