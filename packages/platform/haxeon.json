{
  "version": 1,
  "package": {
    "name": "haxeon-platform",
    "documentation": "required"
  },
  "sourceRoots": [
    "src"
  ],
  "scopeSourceRoots": false,
  "ffi": {
    "interfaces": [
      "bindings/nativekit.hxi",
      "bindings/nativekit-net.hxi",
      { "path": "bindings/nativekit-vulkan.hxi", "platforms": ["linux", "windows", "macos", "android", "ios"] }
    ],
    "projections": [
      "bindings/nativekit.hxmap",
      "bindings/nativekit-net.hxmap",
      "bindings/nativekit-vulkan.hxmap"
    ]
  },
  "publish": {
    "exclude": [
      "tests",
      "tools",
      "docs"
    ]
  },
  "target": "host",
  "dependencies": {
    "haxeon-nativekit": {
      "path": "../nativekit"
    }
  }
}
