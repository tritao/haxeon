{
  "interface": "NativeKit",
  "package": "nativekit.ffi",
  "modules": {
    "functions": "NativeKit",
    "types": "NativeKitTypes",
    "constants": "NativeKitConstants"
  },
  "typePrefix": "nk_",
  "enumValuePrefixes": [
    "NK_NOTIFICATION_"
  ],
  "typeNames": {
    "nk_window": "WindowHandle",
    "nk_surface": "SurfaceHandle",
    "nk_webview": "WebViewHandle",
    "nk_view": "ViewHandle",
    "nk_monitor": "MonitorHandle",
    "nk_cursor": "CursorHandle",
    "nk_joystick": "JoystickHandle",
    "nk_mobile_host": "MobileHostHandle",
    "nk_resource_stream": "ResourceStreamHandle",
    "nk_task": "TaskHandle",
    "nk_transport": "TransportHandle",
    "nk_pty": "PtyHandle",
    "nk_listener": "ListenerHandle",
    "nk_resource_cache": "ResourceCacheHandle",
    "nk_resource_asset": "ResourceAssetHandle",
    "nk_resource": "ResourceValue"
  },
  "resultPolicies": {
    "nk_result": {
      "successValue": "NK_OK",
      "diagnosticFunction": "nk_last_error",
      "errorType": "haxeon.platform.NativeKitError",
      "checkedSuffix": "_checked"
    }
  },
  "enumNames": {
    "nk_resource_asset_load_state": "ResourceAssetLoadState"
  }
}
