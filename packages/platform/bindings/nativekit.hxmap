{
  "interface": "NativeKit",
  "package": "nativekit.ffi",
  "modules": {
    "functions": "NativeKit",
    "types": "NativeKitTypes",
    "constants": "NativeKitConstants"
  },
  "typePrefix": "nk_",
  "enumValuePrefixes": [
    "NK_NOTIFICATION_"
  ],
  "typeNames": {
    "nk_window": "WindowHandle",
    "nk_surface": "SurfaceHandle",
    "nk_webview": "WebViewHandle",
    "nk_view": "ViewHandle",
    "nk_monitor": "MonitorHandle",
    "nk_cursor": "CursorHandle",
    "nk_joystick": "JoystickHandle",
    "nk_mobile_host": "MobileHostHandle",
    "nk_resource_stream": "ResourceStreamHandle",
    "nk_task": "TaskHandle",
    "nk_transport": "TransportHandle",
    "nk_pty": "PtyHandle",
    "nk_listener": "ListenerHandle",
    "nk_menu": "MenuHandle",
    "nk_menu_item": "MenuItemHandle",
    "nk_tray": "TrayHandle",
    "nk_resource_cache": "ResourceCacheHandle",
    "nk_resource_asset": "ResourceAssetHandle",
    "nk_resource": "ResourceValue"
  },
  "resultPolicies": {
    "nk_result": {
      "successValue": "NK_OK",
      "diagnosticFunction": "nk_last_error",
      "errorType": "haxeon.platform.NativeKitError",
      "checkedSuffix": "_checked"
    }
  },
  "enumNames": {
    "nk_resource_asset_load_state": "ResourceAssetLoadState"
  },
  "enumValueNames": {
    "nk_result": {
      "NK_RESULT_HTTP_DNS": "HttpDns",
      "NK_RESULT_HTTP_CONNECTION": "HttpConnection",
      "NK_RESULT_HTTP_TLS": "HttpTls",
      "NK_RESULT_HTTP_TIMEOUT": "HttpTimeout",
      "NK_RESULT_HTTP_CANCELED": "HttpCanceled",
      "NK_RESULT_HTTP_PROTOCOL": "HttpProtocol",
      "NK_RESULT_HTTP_RESPONSE_LIMIT": "HttpResponseLimit",
      "NK_RESULT_HTTP_REDIRECT": "HttpRedirect",
      "NK_RESULT_HTTP_PROXY": "HttpProxy",
      "NK_RESULT_HTTP_WOULD_BLOCK": "HttpWouldBlock",
      "NK_RESULT_TRANSPORT_DNS": "TransportDns",
      "NK_RESULT_TRANSPORT_CONNECTION": "TransportConnection",
      "NK_RESULT_TRANSPORT_TIMEOUT": "TransportTimeout",
      "NK_RESULT_TRANSPORT_PROTOCOL": "TransportProtocol",
      "NK_RESULT_TRANSPORT_CANCELED": "TransportCanceled",
      "NK_RESULT_TRANSPORT_WOULD_BLOCK": "TransportWouldBlock",
      "NK_RESULT_TRANSPORT_CLOSED": "TransportClosed",
      "NK_RESULT_TRANSPORT_ADDRESS_IN_USE": "TransportAddressInUse",
      "NK_RESULT_TRANSPORT_RECEIVE_OVERFLOW": "TransportReceiveOverflow"
    }
  }
}
