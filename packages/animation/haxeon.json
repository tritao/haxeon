{
  "version": 1,
  "package": {
    "name": "haxeon-animation",
    "documentation": "required"
  },
  "sourceRoots": [
    "src"
  ],
  "scopeSourceRoots": false,
  "ffi": {
    "interfaces": [
      "native/bindings/animkit.hxi"
    ]
  },
  "publish": {
    "exclude": [
      "tests",
      "native/vendor",
      "native/src",
      "native/include",
      "native/tests",
      "native/tools",
      "native/CMakeLists.txt",
      "native/haxeon.json",
      "native/THIRD_PARTY.md"
    ]
  },
  "target": "host"
}
