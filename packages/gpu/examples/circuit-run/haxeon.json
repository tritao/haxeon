{
  "version": 1,
  "package": {
    "name": "haxeon-circuit-run"
  },
  "entry": "Main",
  "sourceRoots": ["src"],
  "scopeSourceRoots": false,
  "dependencies": {
    "haxeon-gpu": {
      "path": "../.."
    },
    "haxeon-audio": {
      "path": "../../../audio"
    },
    "haxeon-ui": {
      "path": "../../../ui"
    }
  },
  "native": {
    "cmake": {
      "source": ".",
      "target": "circuit_run_native",
      "inputs": [
        "CMakeLists.txt",
        "../../../ui/CMakeLists.txt",
        "../../../../vendor/nativekit/CMakeLists.txt",
        "../../../../vendor/nativekit/modules/gpu/CMakeLists.txt",
        "../../../../vendor/nativekit/modules/audio/CMakeLists.txt"
      ],
      "library": "nativekit_ui"
    }
  },
  "target": "host",
  "outputDir": "build"
}
