{
  "version": 1,
  "package": {
    "name": "haxeon-ui"
  },
  "sourceRoots": [
    "haxe",
    "bindings/haxe"
  ],
  "scopeSourceRoots": false,
  "dependencies": {
    "haxeon-platform": {
      "path": "../platform"
    },
    "haxeon-gpu": {
      "path": "../gpu"
    },
    "haxeon-editor": {
      "path": "../editor"
    }
  },
  "ffi": {
    "interfaces": [
      "bindings/nativekit-ui.hxi"
    ],
    "projections": [
      "bindings/nativekit-ui.hxmap"
    ]
  },
  "target": "host"
}
