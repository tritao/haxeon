{
  "version": 1,
  "package": {
    "name": "haxeon-credentials"
  },
  "sourceRoots": [
    "src"
  ],
  "scopeSourceRoots": false,
  "ffi": {
    "interfaces": [
      "bindings/nativekit-credentials.hxi"
    ],
    "projections": [
      "bindings/nativekit-credentials.hxmap"
    ]
  },
  "target": "host",
  "native": {
    "cmake": {
      "source": "native",
      "target": "nativekit_credentials",
      "library": "nativekit_credentials"
    }
  },
  "dependencies": {
    "haxeon-platform": {
      "path": "../platform"
    },
    "haxeon-nativekit": {
      "path": "../nativekit"
    }
  },
  "publish": {
    "exclude": [
      "tests",
      "tools"
    ]
  }
}
