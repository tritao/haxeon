{
  "version": 1,
  "package": {
    "name": "haxeon-audio",
    "documentation": "required"
  },
  "sourceRoots": [
    "src"
  ],
  "scopeSourceRoots": false,
  "dependencies": {
    "haxeon-platform": {
      "path": "../platform"
    },
    "haxeon-nativekit": {
      "path": "../nativekit"
    }
  },
  "native": {
    "cmake": {
      "source": "native",
      "target": "nativekit_audio",
      "library": "nativekit_audio"
    }
  },
  "ffi": {
    "interfaces": [
      "bindings/nativekit-audio.hxi"
    ],
    "projections": [
      "bindings/nativekit-audio.hxmap"
    ]
  },
  "publish": {
    "exclude": [
      "tests",
      "tools",
      "examples"
    ]
  },
  "target": "host"
}
