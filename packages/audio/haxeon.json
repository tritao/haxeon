{
  "version": 1,
  "package": {
    "name": "haxeon-audio"
  },
  "sourceRoots": [
    "src"
  ],
  "scopeSourceRoots": false,
  "dependencies": {
    "haxeon-platform": {
      "path": "../platform"
    }
  },
  "ffi": {
    "interfaces": [
      "bindings/nativekit-audio.hxi"
    ],
    "projections": [
      "bindings/nativekit-audio.hxmap"
    ]
  },
  "native": {
    "cmake": {
      "source": ".",
      "target": "nativekit",
      "library": "nativekit",
      "inputs": [
        "CMakeLists.txt",
        "../../vendor/nativekit/CMakeLists.txt",
        "../../vendor/nativekit/modules/audio/CMakeLists.txt"
      ]
    }
  },
  "target": "host"
}
