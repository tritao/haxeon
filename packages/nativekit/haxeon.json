{
	"version": 1,
	"package": { "name": "haxeon-nativekit" },
	"sourceRoots": ["."],
	"scopeSourceRoots": false,
	"native": {
		"cmake": {
			"source": ".",
			"target": "haxeon_nativekit",
			"libraries": ["nativekit", "nativekit_gpu"]
		}
	},
	"publish": {
		"vendor": { "nativekit": "../../vendor/nativekit" },
		"exclude": [
			"nativekit/tests",
			"nativekit/examples",
			"nativekit/docs",
			"nativekit/vendor/daisysp/tests",
			"nativekit/vendor/miniaudio/examples",
			"nativekit/vendor/miniaudio/extras",
			"nativekit/vendor/miniaudio/tests",
			"nativekit/vendor/signalsmith-basics/tests",
			"nativekit/vendor/sokol/tests",
			"nativekit/vendor/tinysoundfont/examples"
		]
	},
	"target": "host"
}
