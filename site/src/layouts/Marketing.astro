---
import ThemeProvider from '@astrojs/starlight/components/ThemeProvider.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeTokens from '../components/ThemeTokens.astro';
import '../styles/theme.css';
import '../styles/marketing.css';

const { title, description = 'A language and runtime for cross-platform apps and tools.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title === 'Haxeon' ? title : `${title} | Haxeon`}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <ThemeTokens />
    <ThemeProvider />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="top"><SiteHeader /></header>
    <main id="main-content"><slot /></main>
    <SiteFooter />
  </body>
</html>
