---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Card from '../components/Card.astro';
import CodeCard from '../components/CodeCard.astro';
import Diagram from '../components/home/Diagram.astro';
import circuitRenderer from '../../../packages/gpu/examples/circuit-run/src/CircuitRenderer.hx?raw';
import { docsUrl, repositorySource } from '../../docs.mjs';

const gpu = (file: string) => repositorySource('packages/gpu/src/haxeon/gpu/' + file + '.hx');
const gpuDocs = repositorySource('packages/gpu/README.md');
const circuit = 'packages/gpu/examples/circuit-run/';
const backends = [
  { platform: 'Linux', api: 'OpenGL 3.3 core', shader: 'GLSL', status: 'Supported' },
  { platform: 'Web', api: 'WebGL2', shader: 'GLSL ES', status: 'Experimental' },
  { platform: 'macOS', api: 'Metal', shader: 'MSL', status: 'Experimental' },
  { platform: 'Windows', api: 'Direct3D 11', shader: 'HLSL 5', status: 'Experimental' },
];
const record = circuitRenderer.match(/^\tpublic function record\([^\n]*\{[\s\S]*?^\t\}/m);
if (!record) throw new Error('Missing CircuitRenderer.record in the GPU page sample');
const sample = record[0]
  .split('\n')
  .filter((line) => !line.includes('hudFraction'))
  .join('\n')
  .replace(/^\t/gm, '');
---

<StarlightPage frontmatter={{
  title: 'GPU',
  template: 'splash',
  prev: false,
  next: false,
  description: 'Draw custom views, games and visualisations with Haxeon’s portable GPU layer.',
}}>
  <div class="landing-content">
    <section class="page-intro paper">
      <div class="wrap hero">
        <div class="head">
          <h1 id="_top" tabindex="-1">A portable GPU layer, built in.</h1>
          <p class="lede">Add your own drawing to an app: charts, maps, editor viewports, games and compute work. Buffers, pipelines and passes are objects in your code, submitted through each platform’s graphics API.</p>
          <ul class="chips" aria-label="Graphics backends">
            {backends.map(({ api, status }) => <li>{api} · {status}</li>)}
          </ul>
          <p>The GPU package is not a game engine. It has no scene graph, asset pipeline or physics.</p>
          <div class="ctas">
            <a class="btn primary" href={gpuDocs}>GPU package README</a>
            <a class="btn ghost" href={repositorySource(circuit + 'src')}>Circuit Run source</a>
          </div>
        </div>
        <figure class="circuit-preview">
          <img src="/gpu/circuit-run.webp" width="540" height="452" alt="Circuit Run: a teal runner and a pink drone in a maze, with a node counter, sound toggle and restart button." />
          <button class="btn primary" type="button" data-circuit-run hidden>Play in the browser</button>
          <p role="status" hidden></p>
          <figcaption>Circuit Run draws its maze and actors with one GPU draw per frame, with UI controls on top.</figcaption>
        </figure>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head">
          <h2>Record a frame</h2>
          <p class="lede">Each frame, Circuit Run updates its vertex buffer, records one draw and seals the window pass in a batch.</p>
        </div>
        <CodeCard code={sample} lang="haxe" title="src/CircuitRenderer.hx" />
        <p class="note"><a href={repositorySource(circuit + 'src/CircuitRenderer.hx')}>Read the whole renderer</a></p>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head"><h2>Inside your UI</h2></div>
        <div class="split">
          <figure>
            <img class="viewport-light" src="/gpu/viewport-light.webp" width="1016" height="498" loading="lazy" alt="A depth-tested cube drawn in a viewport panel of the UI Showcase." />
            <img class="viewport-dark" src="/gpu/viewport-dark.webp" width="1016" height="498" loading="lazy" alt="A depth-tested cube drawn in a viewport panel of the UI Showcase." />
            <figcaption>A live cube in the <a href="/ui/showcase/">UI Showcase</a>’s 3D Views page.</figcaption>
          </figure>
          <div class="stack">
            <Card compact>
              <h3>A viewport in your layout</h3>
              <p>You own the renderer. <a href={repositorySource('packages/ui/haxe/haxeon/ui/widgets/GpuViewport.hx')}><code>GpuViewport</code></a> composites your surface, handles pan and zoom, and redraws only when the camera or your content changes.</p>
            </Card>
            <Card compact>
              <h3>Controls over a scene</h3>
              <p>Draw your scene first, then draw retained UI on the same surface, as Circuit Run does for its counter and buttons.</p>
            </Card>
          </div>
        </div>
        <p class="note"><a href="/ui/">Explore the UI toolkit</a></p>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head"><h2>What the API covers</h2></div>
        <div class="grid three">
          <Card compact>
            <h3>Resources</h3>
            <p>Create buffers, images and samplers, and update dynamic buffers each frame. <a href={gpu('Buffer')}><code>Buffer</code></a></p>
          </Card>
          <Card compact>
            <h3>Pipelines and shaders</h3>
            <p>Build a pipeline from a shader, a vertex layout and render state. <a href={gpu('Pipeline')}><code>Pipeline</code></a></p>
          </Card>
          <Card compact>
            <h3>Passes</h3>
            <p>Open render, compute and copy passes, to the window or to your own attachments. <a href={gpu('Renderer')}><code>Renderer</code></a></p>
          </Card>
          <Card compact>
            <h3>Commands and batches</h3>
            <p>Record commands into a buffer and seal passes into a batch you can submit again. <a href={gpu('CommandBuffer')}><code>CommandBuffer</code></a></p>
          </Card>
          <Card compact>
            <h3>Frames and timing</h3>
            <p>Draw on each frame callback or request frames on demand, and time GPU work where supported. <a href={gpuDocs + '#frame-callbacks'}><code>onFrameTick</code></a></p>
          </Card>
          <Card compact>
            <h3>Limits and device loss</h3>
            <p>Query features and limits before optional operations, and recreate the renderer after device loss. <a href={gpu('Features')}><code>Features</code></a></p>
          </Card>
        </div>
      </div>
    </section>

    <section id="backends">
      <div class="wrap">
        <div class="head">
          <h2>Backends and shaders</h2>
          <p class="lede">Rendering goes through <a href="https://github.com/floooh/sokol">sokol_gfx</a>, a small C library that targets each platform’s native graphics API. Write shaders for each API you target; they are not translated between APIs.</p>
        </div>
        <div class="split">
          <table aria-label="GPU backends">
            <thead><tr><th scope="col">Platform</th><th scope="col">Graphics API</th><th scope="col">Shaders</th><th scope="col">Status</th></tr></thead>
            <tbody>
              {backends.map(({ platform, api, shader, status }) => (
                <tr><th scope="row">{platform}</th><td>{api}</td><td>{shader}</td><td>{status}</td></tr>
              ))}
            </tbody>
          </table>
          <Diagram spaced>
            <svg class="drawing" viewBox="0 0 360 204" role="img" aria-labelledby="gpu-stack-title">
              <title id="gpu-stack-title">Your draw code calls the GPU layer, which runs on sokol_gfx and the platform graphics API.</title>
              <rect class="box" x="55" y="2" width="250" height="32" rx="6" />
              <rect class="box" x="55" y="52" width="250" height="48" rx="6" />
              <rect class="box" x="55" y="118" width="250" height="32" rx="6" />
              <rect class="box" x="55" y="168" width="250" height="32" rx="6" />
              <path class="acc" d="M180 34v16m-4-5 4 5 4-5M180 100v16m-4-5 4 5 4-5M180 150v16m-4-5 4 5 4-5" />
              <text class="ttl" x="180" y="23" text-anchor="middle">Your draw code</text>
              <text class="ttl" x="180" y="72" text-anchor="middle">GPU layer</text>
              <text x="180" y="89" text-anchor="middle">Buffers · Pipelines · Passes</text>
              <text class="ttl" x="180" y="139" text-anchor="middle">sokol_gfx</text>
              <text class="ttl" x="180" y="189" text-anchor="middle">OpenGL · WebGL2 · Metal · D3D11</text>
            </svg>
          </Diagram>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head"><h2>Going lower</h2></div>
        <div class="grid">
          <Card compact>
            <h3>Native handles</h3>
            <p>Pass renderer, shader and pipeline handles to NativeKit’s C GPU API, or borrow the underlying device and context where available. <a href={repositorySource('packages/gpu/bindings/nativekit-gpu.hxi')}>C GPU bindings</a></p>
          </Card>
          <Card compact>
            <h3>Your own graphics code</h3>
            <p>Keep an existing renderer in C or C++ and call it through a C interface. <a href={docsUrl('reference/C_HEADER_FFI.md')}>C FFI</a></p>
          </Card>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head"><h2>Not yet</h2></div>
        <ul class="not-yet">
          <li>Vulkan</li>
          <li>Shader translation between graphics APIs</li>
          <li>Live editing for GPU apps: <a href={docsUrl('reference/CLI.md')}><code>haxeon run --watch</code></a> relaunches them on edits</li>
        </ul>
      </div>
    </section>
  </div>
</StarlightPage>

<style>
  .page-intro .head .ctas { margin-top: 0; }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 34rem); gap: var(--hx-space-6); align-items: center; }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--hx-space-5);
  }
  .three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--hx-space-5);
    align-items: start;
  }
  .stack { display: grid; gap: var(--hx-space-5); }
  figure, .grid p, .stack p { margin: 0; }
  img { display: block; width: 100%; height: auto; border-radius: var(--hx-radius-m); border: 1px solid var(--sl-color-gray-5); }
  .viewport-light, :global([data-theme='light']) .viewport-dark { display: none; }
  :global([data-theme='light']) .viewport-light { display: block; }
  figcaption { margin-top: var(--hx-space-2); color: var(--sl-color-gray-3); }
  .not-yet { margin: 0; padding-inline-start: 1.25rem; }
  li + li { margin-top: var(--hx-space-2); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; }
  .chips li {
    margin: 0;
    padding: 3px 9px;
    font-size: 0.8rem;
    border-radius: var(--hx-radius-pill);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }
  table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--sl-color-gray-5); }
  thead th { font: 600 0.75rem var(--sl-font-mono); color: var(--sl-color-gray-3); }
  .circuit-preview { position: relative; display: grid; justify-items: start; gap: var(--hx-space-3); }
  .circuit-preview [hidden] { display: none; }
  .circuit-preview p { margin: 0; }
  .circuit-preview :global(iframe) { width: 100%; aspect-ratio: 540 / 510; height: auto; border: 0; border-radius: var(--hx-radius-m); }
  .circuit-preview:not([data-running]) :global(iframe) { position: absolute; visibility: hidden; }
  .circuit-preview[data-running] img { display: none; }
  @media (max-width: 55rem) {
    .grid, .split, .hero { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 30rem) {
    th, td { padding-inline: 4px; font-size: 0.8rem; }
  }
</style>

<script>
  const start = document.querySelector<HTMLButtonElement>('[data-circuit-run]');
  const url = '/gpu/circuit-run/index.html';

  if (start) {
    fetch(url, { method: 'HEAD' }).then((response) => {
      start.hidden = !response.ok;
    }).catch(() => {});

    start.addEventListener('click', () => {
      const wrapper = start.parentElement!;
      const status = wrapper.querySelector<HTMLElement>('[role="status"]')!;
      const frame = document.createElement('iframe');
      frame.title = 'Circuit Run';
      frame.src = url;
      start.disabled = true;
      status.hidden = false;
      status.textContent = 'Loading Circuit Run…';

      function failed() {
        delete wrapper.dataset.running;
        frame.remove();
        status.hidden = false;
        status.textContent = 'Circuit Run could not load.';
        start.hidden = false;
        start.disabled = false;
        window.removeEventListener('message', receive);
        window.clearTimeout(timeout);
      }

      function receive(event: MessageEvent) {
        if (event.origin !== location.origin || event.source !== frame.contentWindow) return;
        if (event.data === 'haxeon-circuit-run-ready') {
          window.clearTimeout(timeout);
          wrapper.dataset.running = '';
          status.hidden = true;
          start.hidden = true;
          frame.contentDocument?.querySelector('canvas')?.focus();
        } else if (event.data === 'haxeon-circuit-run-failed') {
          failed();
        }
      }

      const timeout = window.setTimeout(failed, 30000);
      window.addEventListener('message', receive);
      wrapper.prepend(frame);
    });
  }
</script>
