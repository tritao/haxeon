---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Card from '../components/Card.astro';
import CodeCard from '../components/CodeCard.astro';
import Diagram from '../components/home/Diagram.astro';
import StatusBadge, { type Status } from '../components/StatusBadge.astro';
import triangleMain from '../../../packages/gpu/examples/triangle/src/Main.hx?raw';
import triangleShader from '../../../packages/gpu/examples/triangle/src/shaders/Triangle.glsl?raw';
import particlesMain from '../../../packages/gpu/examples/particles/src/Main.hx?raw';
import { docsUrl, repositorySource } from '../../docs.mjs';

const gpu = (file: string) => repositorySource('packages/gpu/src/haxeon/gpu/' + file + '.hx');
const gpuDocs = repositorySource('packages/gpu/README.md');
const circuit = 'packages/gpu/examples/circuit-run/';
const backends: { platform: string; api: string; status: Status; compute: string; timestamps: string }[] = [
  { platform: 'Linux', api: 'OpenGL 4.1 core', status: 'Supported', compute: 'GL 4.3+ drivers', timestamps: 'Yes' },
  { platform: 'Web', api: 'WebGL2', status: 'Supported', compute: 'No', timestamps: 'No' },
  { platform: 'macOS', api: 'Metal', status: 'Supported', compute: 'Yes', timestamps: 'Depends on GPU' },
  { platform: 'Windows', api: 'Direct3D 11', status: 'Supported', compute: 'Yes', timestamps: 'Yes' },
  { platform: 'Web', api: 'WebGPU', status: 'Planned', compute: '–', timestamps: '–' },
  { platform: 'Linux, Windows', api: 'Vulkan', status: 'Planned', compute: '–', timestamps: '–' },
];
const available = backends.filter(({ status }) => status !== 'Planned');
const triangle = 'packages/gpu/examples/triangle/';
const particles = 'packages/gpu/examples/particles/';
const method = (source: string, name: string) => {
  const found = source.match(new RegExp(`^\\tpublic function ${name}\\([\\s\\S]*?^\\t\\}`, 'm'));
  if (!found) throw new Error(`Missing Main.${name} in a GPU example`);
  return found[0].replace(/^\t/gm, '');
};
const ready = method(triangleMain, 'ready');
const frame = method(triangleMain, 'frame');
const computeFrame = method(particlesMain, 'frame');
const appLines = triangleMain.trimEnd().split('\n').length;
---

<StarlightPage frontmatter={{
  title: 'GPU',
  template: 'splash',
  prev: false,
  next: false,
  description: 'Draw custom views, games and visualisations with Haxeon’s portable GPU layer.',
}}>
  <div class="landing-content">
    <section class="page-intro paper">
      <div class="wrap hero">
        <div class="head">
          <h1 id="_top" tabindex="-1">A portable GPU layer, built in.</h1>
          <p class="lede">Add your own drawing to an app: charts, maps, editor viewports, games and compute work. Buffers, pipelines and passes are objects in your code, submitted through each platform’s graphics API.</p>
          <ul class="chips" aria-label="Supported graphics backends">
            {available.map(({ api, status }) => <li><StatusBadge status={status}>{api}</StatusBadge></li>)}
          </ul>
          <p>The GPU package is not a game engine. It has no scene graph, asset pipeline or physics.</p>
          <div class="ctas">
            <a class="btn primary" href={gpuDocs}>GPU package README</a>
            <a class="btn ghost" href={repositorySource(circuit + 'src')}>Circuit Run source</a>
          </div>
        </div>
        <figure class="circuit-preview">
          <img src="/gpu/circuit-run.webp" width="540" height="452" alt="Circuit Run: a teal runner and a pink drone in a maze, with a node counter, sound toggle and restart button." />
          <button class="btn primary" type="button" data-circuit-run data-pending>Play in the browser</button>
          <p role="status" hidden></p>
          <figcaption>Circuit Run draws its maze and actors with one GPU draw per frame, with UI controls on top.</figcaption>
        </figure>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head">
          <h2>Draw your first frame</h2>
          <p class="lede">The Triangle example is one class of {appLines} lines. It sets up once when the surface is ready, then submits the same draw each frame.</p>
        </div>
        <div class="grid first-frame">
          <CodeCard code={ready} lang="haxe" title="Once · src/Main.hx" />
          <div class="stack">
            <CodeCard code={frame} lang="haxe" title="Each frame · src/Main.hx" />
            <figure>
              <img src="/gpu/triangle.webp" width="640" height="360" loading="lazy" alt="A triangle shaded from pink at the top to green and blue at its lower corners, on a dark background." />
            </figure>
          </div>
        </div>
        <p class="note"><a href={repositorySource(triangle + 'src/Main.hx')}>Read the whole app</a> · <a href={repositorySource(triangle + 'README.md')}>Run it</a></p>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head"><h2>Inside your UI</h2></div>
        <div class="split">
          <figure>
            <img class="viewport-light" src="/gpu/viewport-light.webp" width="778" height="502" loading="lazy" alt="A depth-tested cube drawn in a viewport panel of the UI Showcase." />
            <img class="viewport-dark" src="/gpu/viewport-dark.webp" width="778" height="502" loading="lazy" alt="A depth-tested cube drawn in a viewport panel of the UI Showcase." />
            <figcaption>A live cube in the <a href="/ui/showcase/">UI Showcase</a>’s 3D Views page.</figcaption>
          </figure>
          <div class="stack">
            <Card compact>
              <h3>A viewport in your layout</h3>
              <p>You own the renderer. <a href={repositorySource('packages/ui/haxe/haxeon/ui/widgets/GpuViewport.hx')}><code>GpuViewport</code></a> composites your surface, handles pan and zoom, and redraws only when the camera or your content changes.</p>
            </Card>
            <Card compact>
              <h3>Controls over a scene</h3>
              <p>Draw your scene first, then draw retained UI on the same surface, as Circuit Run does for its counter and buttons.</p>
            </Card>
          </div>
        </div>
        <p class="note"><a href="/ui/">Explore the UI toolkit</a></p>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head"><h2>How the API fits together</h2></div>
        <div class="split api">
          <Diagram spaced>
            <svg class="drawing" viewBox="0 0 360 330" role="img" aria-labelledby="gpu-api-title">
              <title id="gpu-api-title">A Renderer creates buffers, images, samplers, shaders and pipelines. They are bound in a CommandBuffer, sealed into a Batch and submitted to a surface frame.</title>
              <rect class="box" x="55" y="2" width="250" height="36" rx="6" />
              <rect class="box" x="55" y="70" width="250" height="54" rx="6" />
              <rect class="box" x="55" y="156" width="250" height="36" rx="6" />
              <rect class="box" x="55" y="224" width="250" height="36" rx="6" />
              <rect class="box" x="55" y="292" width="250" height="36" rx="6" />
              <path class="acc" d="M180 38v30m-4-5 4 5 4-5M180 124v30m-4-5 4 5 4-5M180 192v30m-4-5 4 5 4-5M180 260v30m-4-5 4 5 4-5" />
              <text x="192" y="59">creates</text>
              <text x="192" y="145">bound in</text>
              <text x="192" y="213">sealed in</text>
              <text x="192" y="281">submitted to</text>
              <a href={gpu('Renderer')}><text class="lnk" x="180" y="25" text-anchor="middle">Renderer</text></a>
              <text x="180" y="93" text-anchor="middle"><a href={gpu('Buffer')}><tspan class="lnk">Buffer</tspan></a> · <a href={gpu('Image')}><tspan class="lnk">Image</tspan></a> · <a href={gpu('Sampler')}><tspan class="lnk">Sampler</tspan></a></text>
              <text x="180" y="113" text-anchor="middle"><a href={gpu('Shader')}><tspan class="lnk">Shader</tspan></a> → <a href={gpu('Pipeline')}><tspan class="lnk">Pipeline</tspan></a></text>
              <a href={gpu('CommandBuffer')}><text class="lnk" x="180" y="179" text-anchor="middle">CommandBuffer</text></a>
              <a href={gpu('Batch')}><text class="lnk" x="180" y="247" text-anchor="middle">Batch</text></a>
              <text class="ttl" x="180" y="315" text-anchor="middle">Surface frame</text>
            </svg>
          </Diagram>
          <div class="stack">
            <Card compact>
              <h3>Frames only when needed</h3>
              <p>Switch a surface to <a href={gpuDocs + '#frame-callbacks'}>on-demand frames</a> and request one when something changes, so an idle app does not redraw.</p>
            </Card>
            <Card compact>
              <h3>Record once, submit again</h3>
              <p>Seal passes and their commands into a batch, then submit the same batch on later frames without recording it again.</p>
            </Card>
            <Card compact>
              <h3>Clear failures</h3>
              <p>Errors name the operation that failed, including device loss. Misuse, such as binding a resource from another renderer, is rejected before it reaches the GPU.</p>
            </Card>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head">
          <h2>Shaders</h2>
          <p class="lede">Write a shader once in GLSL. The build compiles it for each backend with <a href="https://github.com/floooh/sokol-tools/blob/master/docs/sokol-shdc.md" class="nowrap">sokol-shdc</a> and generates a typed module for it.</p>
        </div>
        <ol class="shader-flow" aria-label="Shader build">
          <li><span>Triangle.glsl</span></li>
          <li><span>sokol-shdc</span></li>
          <li><span>GLSL 4.1 · GLSL ES 3.0 · HLSL 5 · Metal</span></li>
          <li><span>shaders.Triangle</span></li>
        </ol>
        <div class="grid">
          <CodeCard code={triangleShader} lang="sokol-shdc" title="src/shaders/Triangle.glsl" />
          <div class="stack">
            <Card compact>
              <h3>Typed layouts and uniforms</h3>
              <p><code>Triangle.create</code> builds the shader and <code>Triangle.Vertex</code> gives its vertex layout, offsets and stride. Each uniform block becomes a record with checked std140 offsets.</p>
            </Card>
            <Card compact>
              <h3>Rebuilt while you work</h3>
              <p><a href={docsUrl('reference/CLI.md')}><code>haxeon run --watch</code></a> rebuilds a shader when it or one of its includes changes, then relaunches the app.</p>
            </Card>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head">
          <h2>Compute</h2>
          <p class="lede">The Particles example moves 8,192 particles with a compute shader, then draws them from the same storage buffer. Nothing goes back to the CPU.</p>
        </div>
        <div class="grid first-frame">
          <figure>
            <img src="/gpu/particles.webp" width="640" height="640" loading="lazy" alt="A fountain of small square particles, pink and fast near the spout, green and slow near the top." />
          </figure>
          <CodeCard code={computeFrame} lang="haxe" title="Each frame · src/Main.hx" />
        </div>
        <p class="note"><a href={repositorySource(particles + 'src/shaders/Particles.glsl')}>Read the shaders</a> · <a href={repositorySource(particles + 'README.md')}>Run it</a></p>
      </div>
    </section>

    <section id="backends">
      <div class="wrap">
        <div class="head">
          <h2>Backends</h2>
          <p class="lede">Rendering goes through <a href="https://github.com/floooh/sokol">sokol_gfx</a>, a small C library that targets each platform’s native graphics API. It also has WebGPU and Vulkan backends, which are planned here.</p>
        </div>
        <div class="split backends">
          <div class="tables">
            <table aria-label="GPU backends">
              <thead><tr><th scope="col">Platform</th><th scope="col">Status</th><th scope="col">Compute</th><th scope="col">Timestamps</th></tr></thead>
              <tbody>
                {backends.map(({ platform, api, status, compute, timestamps }) => (
                  <tr><th scope="row">{platform}<span class="api-name">{api}</span></th><td><StatusBadge status={status} /></td><td>{compute}</td><td>{timestamps}</td></tr>
                ))}
              </tbody>
            </table>
            <p class="note">Image and buffer readback work on every backend.</p>
          </div>
          <Diagram spaced>
            <svg class="drawing" viewBox="0 0 360 204" role="img" aria-labelledby="gpu-stack-title">
              <title id="gpu-stack-title">Your draw code calls the GPU layer, which runs on sokol_gfx and the platform graphics API.</title>
              <rect class="box" x="55" y="2" width="250" height="32" rx="6" />
              <rect class="box" x="55" y="52" width="250" height="48" rx="6" />
              <rect class="box" x="55" y="118" width="250" height="32" rx="6" />
              <rect class="box" x="55" y="168" width="250" height="32" rx="6" />
              <path class="acc" d="M180 34v16m-4-5 4 5 4-5M180 100v16m-4-5 4 5 4-5M180 150v16m-4-5 4 5 4-5" />
              <text class="ttl" x="180" y="23" text-anchor="middle">Your draw code</text>
              <text class="ttl" x="180" y="72" text-anchor="middle">GPU layer</text>
              <text x="180" y="89" text-anchor="middle">Buffers · Pipelines · Passes</text>
              <text class="ttl" x="180" y="139" text-anchor="middle">sokol_gfx</text>
              <text class="ttl" x="180" y="189" text-anchor="middle">OpenGL · WebGL2 · Metal · D3D11</text>
            </svg>
          </Diagram>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head"><h2>Going lower</h2></div>
        <div class="grid">
          <Card compact>
            <h3>Native handles</h3>
            <p>Pass renderer, shader and pipeline handles to <a href={repositorySource('packages/gpu/bindings/nativekit-gpu.hxi')}>NativeKit’s C GPU API</a>, or borrow the underlying device and context where available.</p>
          </Card>
          <Card compact>
            <h3>Your own graphics code</h3>
            <p>Keep an existing renderer in C or C++ and call it through <a href={docsUrl('reference/C_HEADER_FFI.md')}>the C FFI</a>.</p>
          </Card>
        </div>
      </div>
    </section>
  </div>
</StarlightPage>

<style>
  .page-intro .head .ctas { margin-top: 0; }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 34rem); gap: var(--hx-space-6); align-items: start; }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--hx-space-5);
  }
  .three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--hx-space-5);
    align-items: start;
  }
  .shader-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--hx-space-2) var(--hx-space-3);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--hx-space-5);
    font: 600 0.82rem var(--sl-font-mono);
  }
  .shader-flow li { margin: 0; display: flex; align-items: center; gap: var(--hx-space-3); }
  .shader-flow li + li::before { content: '→'; color: var(--sl-color-accent); }
  .shader-flow span { padding: 4px 10px; border: 1px solid var(--sl-color-gray-5); border-radius: var(--hx-radius-s); background: var(--sl-color-bg-sidebar); }
  .nowrap { white-space: nowrap; }
  .first-frame { align-items: start; }
  .stack { display: grid; gap: var(--hx-space-5); align-content: start; }
  .api-name { display: block; font-weight: 400; font-size: 0.85rem; color: var(--sl-color-gray-3); }
  .api { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); align-items: stretch; }
  .api > :global(.figure) { display: grid; align-content: center; }
  .tables { display: grid; gap: var(--hx-space-3); align-content: start; }
  .backends { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); align-items: stretch; }
  .backends > :global(.figure) { display: grid; align-content: center; }
  .drawing .lnk { fill: var(--sl-color-text-accent); font-weight: 600; text-decoration: underline; }
  figure, .grid p, .stack p { margin: 0; }
  img { display: block; width: 100%; height: auto; border-radius: var(--hx-radius-m); border: 1px solid var(--sl-color-gray-5); }
  .viewport-light, :global([data-theme='light']) .viewport-dark { display: none; }
  :global([data-theme='light']) .viewport-light { display: block; }
  figcaption { margin-top: var(--hx-space-2); color: var(--sl-color-gray-3); }
  li + li { margin-top: var(--hx-space-2); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; }
  .chips li { margin: 0; }
  table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--sl-color-gray-5); }
  thead th { font: 600 0.75rem var(--sl-font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--sl-color-gray-3); }
  .circuit-preview { position: relative; display: grid; justify-items: start; gap: var(--hx-space-3); }
  .circuit-preview [hidden] { display: none; }
  .circuit-preview [data-pending] { visibility: hidden; }
  .circuit-preview p { margin: 0; }
  .circuit-preview :global(iframe) { width: 100%; aspect-ratio: 540 / 510; height: auto; border: 0; border-radius: var(--hx-radius-m); }
  .circuit-preview:not([data-running]) :global(iframe) { position: absolute; visibility: hidden; }
  .circuit-preview[data-running] img { display: none; }
  @media (max-width: 55rem) {
    .grid, .split, .hero { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 30rem) {
    th, td { padding-inline: 4px; font-size: 0.8rem; }
  }
</style>

<script>
  const start = document.querySelector<HTMLButtonElement>('[data-circuit-run]');
  const url = '/gpu/circuit-run/index.html';

  if (start) {
    // The button keeps its space while the check runs, so a present build does not shift the hero.
    fetch(url, { method: 'HEAD' }).then((response) => {
      start.hidden = !response.ok;
    }).catch(() => {
      start.hidden = true;
    }).finally(() => {
      delete start.dataset.pending;
    });

    start.addEventListener('click', () => {
      const wrapper = start.parentElement!;
      const status = wrapper.querySelector<HTMLElement>('[role="status"]')!;
      const frame = document.createElement('iframe');
      frame.title = 'Circuit Run';
      frame.src = url;
      start.disabled = true;
      status.hidden = false;
      status.textContent = 'Loading Circuit Run…';

      function failed() {
        delete wrapper.dataset.running;
        frame.remove();
        status.hidden = false;
        status.textContent = 'Circuit Run could not load.';
        start.hidden = false;
        start.disabled = false;
        window.removeEventListener('message', receive);
        window.clearTimeout(timeout);
      }

      function receive(event: MessageEvent) {
        if (event.origin !== location.origin || event.source !== frame.contentWindow) return;
        if (event.data?.type !== 'haxeon-app') return;
        if (event.data.state === 'ready') {
          window.clearTimeout(timeout);
          wrapper.dataset.running = '';
          status.hidden = true;
          start.hidden = true;
          frame.contentDocument?.querySelector('canvas')?.focus();
        } else if (event.data.state === 'failed') {
          failed();
        }
      }

      const timeout = window.setTimeout(failed, 30000);
      window.addEventListener('message', receive);
      wrapper.prepend(frame);
    });
  }
</script>
