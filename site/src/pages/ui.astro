---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Card from '../components/Card.astro';
import CodeCard from '../components/CodeCard.astro';
import Diagram from '../components/home/Diagram.astro';
import PlatformTable from '../components/PlatformTable.astro';
import counter from '../../../docs/guides/examples/01-first-app/my_app/src/Main.hx?raw';
import { docsUrl, repositorySource } from '../../docs.mjs';

const basics = docsUrl('guides/03-ui-basics.md');
const firstApp = docsUrl('guides/01-first-app.md');
const packageDocs = repositorySource('packages/ui/README.md');
const showcase = repositorySource('packages/ui/examples/ui_showcase/README.md');
const source = counter.match(/^\tfunction view\(\):View \{[\s\S]*?^\t\}/m)![0];
const view = source.replace(/^\t/gm, '');
---

<StarlightPage
  frontmatter={{
    title: 'UI',
    template: 'splash',
    prev: false,
    next: false,
    description: 'Build cross-platform apps with Haxeon’s retained, GPU-drawn UI toolkit.',
  }}
>
  <div class="landing-content">
    <section class="page-intro paper">
      <div class="wrap">
        <div class="head">
          <h1 id="_top" tabindex="-1">A native UI toolkit, built in.</h1>
          <p class="lede">Retained views drawn on the GPU, the same on every platform. Supported live edits keep your running app’s state.</p>
          <div class="ctas">
            <a class="btn primary" href={basics}>UI basics</a>
            <a class="btn ghost" href="/ui/showcase/">Open the Showcase</a>
          </div>
        </div>
        <div class="live-showcase">
          <img class="showcase-light" src="/ui/showcase-light.png" width="1280" height="900" alt="The UI Showcase’s Controls page: buttons, switches, radio options, a slider and progress bars, with a component catalog and an inspector." />
          <img class="showcase-dark" src="/ui/showcase-dark.png" width="1280" height="900" alt="The UI Showcase’s Controls page: buttons, switches, radio options, a slider and progress bars, with a component catalog and an inspector." />
          <button class="btn primary" type="button" data-showcase-src="/ui/showcase/?embed" data-pending>Start the live Showcase</button>
          <p role="status" hidden></p>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head">
          <h2>Your first view</h2>
          <p class="lede">A view is built from your app’s state. A <code>Signal</code> holds the count, and the window redraws when its value changes.</p>
        </div>
        <div class="sample">
          <CodeCard code={view} lang="haxe" title="src/Main.hx" example="ui-counter" />
          <figure class="window">
            <img src="/ui/counter-window.png" width="260" height="208" alt="The counter window after two clicks: My first app, You clicked 2 times, and Click me and Reset buttons." />
          </figure>
        </div>
        <p class="note"><a href={firstApp + '#change-the-ui'}>Build it in Your first app</a></p>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head"><h2>Build the interface</h2></div>
        <div class="grid three">
          <Card compact>
            <h3>Views and layout</h3>
            <p>Compose keyed views into <a href={basics + '#layout-and-text'}>rows and columns</a>, rebuilt from your app’s state each frame.</p>
          </Card>
          <Card compact>
            <h3>Text</h3>
            <p>Shape <a href={packageDocs}>multilingual text</a> with bidirectional runs and line wrapping, and edit it with selection and IME composition.</p>
          </Card>
          <Card compact>
            <h3>Widgets</h3>
            <p>Build <a href={basics + '#forms'}>forms</a> from buttons, toggles, sliders and text fields, and show large collections in virtualized lists, trees and grids.</p>
          </Card>
          <Card compact>
            <h3>Overlays and input</h3>
            <p>Show dialogs, menus, popups and tooltips over your content. Route pointer and keyboard input, manage focus, and animate <a href={showcase}>taps and drags</a>.</p>
          </Card>
          <Card compact>
            <h3>Theme and accessibility</h3>
            <p>Switch between light and dark <a href={basics + '#theming'}>themes</a> or supply your own tokens, and expose roles, labels and actions in a semantic tree.</p>
          </Card>
          <Card compact>
            <h3>Native services</h3>
            <p>Open file dialogs, read the clipboard, add menus, tray icons and notifications, and embed a web view through the <a href={repositorySource('packages/platform/README.md')}><code>platform</code> package</a>.</p>
          </Card>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head">
          <h2>How it is built</h2>
          <p class="lede">Your views describe the interface. The UI layer resolves layout, prepares text and builds a render plan, which the GPU layer submits through the platform’s graphics API.</p>
        </div>
        <div class="split">
          <Diagram spaced>
            <svg class="drawing" viewBox="0 0 360 262" role="img" aria-labelledby="ui-pipeline-title">
              <title id="ui-pipeline-title">Your views flow through UI layout, text and render planning, then the GPU layer and the platform graphics API.</title>
              <rect class="box" x="55" y="2" width="250" height="36" rx="6" />
              <rect class="box" x="55" y="70" width="250" height="54" rx="6" />
              <rect class="box" x="55" y="156" width="250" height="36" rx="6" />
              <rect class="box" x="55" y="224" width="250" height="36" rx="6" />
              <path class="acc" d="M180 38v30m-4-5 4 5 4-5M180 124v30m-4-5 4 5 4-5M180 192v30m-4-5 4 5 4-5" />
              <text class="ttl" x="180" y="25" text-anchor="middle">Your views</text>
              <text class="ttl" x="180" y="93" text-anchor="middle">UI layer</text>
              <text x="180" y="113" text-anchor="middle">Layout · Text · Render plan</text>
              <text class="ttl" x="180" y="179" text-anchor="middle"><a href="/gpu/"><tspan class="lnk">GPU layer</tspan></a></text>
              <text class="ttl" x="180" y="247" text-anchor="middle">Platform graphics API</text>
            </svg>
          </Diagram>
          <div class="stack">
            <Card compact>
              <h3>Rebuilt from state, repainted where it changed</h3>
              <p>Each frame builds the view tree from your state. The UI keeps what did not change and repaints only what did.</p>
            </Card>
            <Card compact>
              <h3>Text shaped by the toolkit</h3>
              <p>HarfBuzz shapes text, SheenBidi orders bidirectional runs and libunibreak finds line breaks, the same way on every platform.</p>
            </Card>
            <Card compact>
              <h3>The same pixels everywhere</h3>
              <p>The toolkit draws its own widgets instead of wrapping each platform’s, so a layout looks the same on Linux, macOS, Windows and the web.</p>
            </Card>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head">
          <h2>Platforms</h2>
          <p class="lede">The native platform ABI is still evolving, and which services are available depends on the host.</p>
        </div>
        <PlatformTable />
        <p class="note">On Android the UI toolkit is an opt-in library of the host, not yet in the app template. <a href={docsUrl('reference/ANDROID.md')}>Android reference</a></p>
      </div>
    </section>
  </div>
</StarlightPage>

<style>
  .page-intro .head .ctas { margin-top: 0; }
  .grid, .sample {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--hx-space-5);
  }
  .three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .sample { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); align-items: start; }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--hx-space-5);
    align-items: stretch;
  }
  .split > :global(.figure) { display: grid; align-content: center; }
  .stack { display: grid; gap: var(--hx-space-5); align-content: start; }
  figure { margin: 0; }
  img { display: block; width: 100%; height: auto; border-radius: var(--hx-radius-m); border: 1px solid var(--sl-color-gray-5); }
  .window img { max-width: 22rem; }
  .grid p, .stack p { margin: 0; }
  .showcase-light, :global([data-theme='light']) .showcase-dark { display: none; }
  :global([data-theme='light']) .showcase-light { display: block; }
  .drawing .lnk { fill: var(--sl-color-text-accent); text-decoration: underline; }
  @media (max-width: 55rem) {
    .grid, .sample, .split { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  const start = document.querySelector<HTMLButtonElement>('[data-showcase-src]');
  if (start) {
    delete start.dataset.pending;
    start.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.title = 'Haxeon UI Showcase';
      frame.src = start.dataset.showcaseSrc!;
      const wrapper = start.parentElement!;
      const status = wrapper.querySelector('[role="status"]') as HTMLElement;
      status.hidden = false;
      status.textContent = 'Loading the Showcase…';
      start.disabled = true;

      // Keep the catalog and workspace in view at narrow widths.
      const resize = new ResizeObserver(([entry]) => {
        const available = entry.contentRect.width;
        const width = Math.max(700, available);
        frame.style.width = `${width}px`;
        frame.style.zoom = String(available / width);
      });
      resize.observe(wrapper);

      function receive(event: MessageEvent) {
        if (event.origin !== location.origin || event.source !== frame.contentWindow) return;
        if (event.data === 'haxeon-showcase-ready') {
          wrapper.dataset.running = '';
          status.hidden = true;
          start.hidden = true;
        } else if (event.data === 'haxeon-showcase-failed') {
          delete wrapper.dataset.running;
          resize.disconnect();
          frame.remove();
          status.hidden = false;
          status.textContent = 'The Showcase could not load.';
          start.hidden = false;
          start.disabled = false;
          window.removeEventListener('message', receive);
        }
      }

      window.addEventListener('message', receive);
      wrapper.prepend(frame);
    });
  }
</script>

<style>
  .live-showcase { position: relative; display: grid; justify-items: start; gap: 0.75rem; margin-bottom: 2rem; }
  .live-showcase [hidden] { display: none; }
  .live-showcase [data-pending] { visibility: hidden; }
  .live-showcase img, .live-showcase :global(iframe) { width: 100%; height: auto; }
  .live-showcase :global(iframe) { aspect-ratio: 3 / 2; border: 0; min-height: 600px; }
  .live-showcase:not([data-running]) :global(iframe) { position: absolute; visibility: hidden; }
  .live-showcase[data-running] img { display: none; }
</style>
