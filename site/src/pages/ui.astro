---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Card from '../components/Card.astro';
import CodeCard from '../components/CodeCard.astro';
import Diagram from '../components/home/Diagram.astro';
import PlatformTable from '../components/PlatformTable.astro';
import counter from '../../../docs/guides/examples/01-first-app/my_app/src/Main.hx?raw';
import { docsUrl, repositorySource } from '../../docs.mjs';

const basics = docsUrl('guides/03-ui-basics.md');
const firstApp = docsUrl('guides/01-first-app.md');
const packageDocs = repositorySource('packages/ui/README.md');
const showcase = repositorySource('packages/ui/examples/ui_showcase/README.md');
const source = counter.match(/^\tfunction view\(\):View \{[\s\S]*?^\t\}/m)![0];
const view = source.replace(/^\t/gm, '');
---

<StarlightPage
  frontmatter={{
    title: 'UI',
    template: 'splash',
    prev: false,
    next: false,
    description: 'Build cross-platform apps with Haxeon’s retained, GPU-drawn UI toolkit.',
  }}
>
  <div class="landing-content">
    <section class="page-intro paper">
      <div class="wrap hero">
        <div class="head">
          <h1 id="_top" tabindex="-1">A native UI toolkit, built in.</h1>
          <p class="lede">Describe a window from your app’s state, and the toolkit lays it out and draws it on the GPU, the same on every platform. Supported live edits keep your running app’s state.</p>
          <div class="ctas">
            <a class="btn primary" href={basics}>UI basics</a>
            <a class="btn ghost" href={firstApp + '#change-the-ui'}>Your first app</a>
          </div>
        </div>
        <div class="sample">
          <CodeCard code={view} lang="haxe" title="src/Main.hx" example="ui-counter" />
          <figure class="window">
            <img src="/ui/counter-window.png" width="260" height="208" alt="The counter window after two clicks: My first app, You clicked 2 times, and Click me and Reset buttons." />
            <figcaption>A <code>Signal</code> holds the count; the window redraws when it changes.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head">
          <h2>How it works</h2>
          <p class="lede">You describe the window in code. A native core lays it out, shapes its text and draws it on the GPU.</p>
        </div>
        <div class="split">
          <Diagram spaced>
            <svg class="drawing" viewBox="0 0 360 344" role="img" aria-labelledby="ui-design-title">
              <title id="ui-design-title">Your views feed the UI framework, which hands them to the native core for layout, text and the render plan; the GPU layer draws them through the platform graphics API.</title>
              <rect class="box" x="55" y="2" width="250" height="36" rx="6" />
              <rect class="box" x="55" y="70" width="250" height="54" rx="6" />
              <rect class="box" x="55" y="156" width="250" height="54" rx="6" />
              <rect class="box" x="55" y="242" width="250" height="36" rx="6" />
              <rect class="box" x="55" y="306" width="250" height="36" rx="6" />
              <path class="acc" d="M180 38v30m-4-5 4 5 4-5M180 124v30m-4-5 4 5 4-5M180 210v30m-4-5 4 5 4-5M180 278v26m-4-5 4 5 4-5" />
              <text class="ttl" x="180" y="25" text-anchor="middle">Your views</text>
              <text class="ttl" x="180" y="93" text-anchor="middle">UI framework</text>
              <text x="180" y="113" text-anchor="middle">State · Events · Semantics</text>
              <text class="ttl" x="180" y="179" text-anchor="middle">Native core</text>
              <text x="180" y="199" text-anchor="middle">Layout · Text · Render plan</text>
              <text class="ttl" x="180" y="265" text-anchor="middle"><a href="/gpu/"><tspan class="lnk">GPU layer</tspan></a></text>
              <text class="ttl" x="180" y="329" text-anchor="middle">Platform graphics API</text>
            </svg>
          </Diagram>
          <div class="stack">
            <Card compact>
              <h3>Views from state</h3>
              <p>Your <code>view()</code> describes the window from your app’s state. Keys tell the UI which view is which from one frame to the next, and a <code>Signal</code> marks what changed, so you never update widgets by hand.</p>
            </Card>
            <Card compact>
              <h3>A retained core underneath</h3>
              <p>Your code owns behaviour: state, focus, events, semantics and animation. The native core owns layout, text and drawing. It keeps a retained display list, compiles it into a render plan and repaints only what changed.</p>
            </Card>
            <Card compact>
              <h3>One renderer everywhere</h3>
              <p>The toolkit draws its own widgets, with text shaped by HarfBuzz, so a layout looks the same on every platform. It can own a window, or draw inside your <a href="/gpu/">GPU app</a> through a <code>UiOverlay</code>.</p>
            </Card>
          </div>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head">
          <h2>Every app gets</h2>
          <p class="lede">The building blocks of an interface, ready to compose.</p>
        </div>
        <ul class="features">
          <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M10 10v10"/></svg><h3>Layout and text</h3><p>Rows, columns and scrolling; multilingual text with wrapping and editing.</p></li>
          <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="8" width="18" height="8" rx="4"/><circle cx="15" cy="12" r="2.5"/></svg><h3>Widgets and data</h3><p>Buttons, toggles, sliders and fields; virtualized lists, trees and grids.</p></li>
          <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="7" width="13" height="13" rx="2"/><path d="M8 7V4h13v13h-5"/></svg><h3>Overlays and navigation</h3><p>Dialogs, menus, popups and tooltips; tabs and sidebars.</p></li>
          <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18c1.5 0 2-1 2-2s-1-1.5-1-2.5 1-1.5 2-1.5h2a4 4 0 0 0 4-4c0-4.4-4-8-9-8z"/><circle cx="7.5" cy="11" r="1"/><circle cx="10" cy="7" r="1"/><circle cx="15" cy="7" r="1"/></svg><h3>Style and themes</h3><p>Light and dark themes or your own tokens; borders, blurs and colour effects.</p></li>
          <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3l6 16 2.5-6.5L20 10z"/></svg><h3>Input and motion</h3><p>Pointer, keyboard and focus; gestures from taps to pinches; tweens and springs.</p></li>
          <li><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="4.5" r="1.8"/><path d="M5 8l7 1.5L19 8M12 9.5V14l-3 6M12 14l3 6"/></svg><h3>Accessibility</h3><p>Roles, labels, values and actions in a semantic tree, with an audit.</p></li>
        </ul>
        <p class="note"><a href={basics}>Build a small app with them in UI basics</a></p>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head">
          <h2>Built for tools and editors</h2>
          <p class="lede">The parts that editors, inspectors and other tools are made of, so you build the tool instead of its framework.</p>
        </div>
        <ul class="features tools">
          <li><h3>Docking workspaces</h3><p>Panels that split, tab and dock, with layouts saved between sessions.</p></li>
          <li><h3>Property inspectors</h3><p>Typed editors for an object’s properties, with undoable edits.</p></li>
          <li><h3>Commands and undo</h3><p>Menus, toolbars and a command palette share commands, shortcuts and an edit history.</p></li>
          <li><h3>Settings</h3><p>Typed settings stored for you, with rebindable keyboard shortcuts.</p></li>
          <li><h3>Plots and viewports</h3><p>Series of data, and your own GPU drawing in a viewport that pans and zooms.</p></li>
          <li><h3>Inspector and diagnostics</h3><p>Inspect any view’s layout, style and semantics while the app runs.</p></li>
        </ul>
        <p class="note"><a href={packageDocs}>Read the UI package documentation</a></p>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head">
          <h2>Try the Showcase</h2>
          <p class="lede">Every control and its states, text in many scripts, graphics and 3D, with an inspector for each view.</p>
        </div>
        <div class="live-showcase">
          <img class="showcase-light" src="/ui/showcase-light.png" width="1280" height="900" loading="lazy" alt="The UI Showcase’s Controls page: buttons, switches, radio options, a slider and progress bars, with a component catalog and an inspector." />
          <img class="showcase-dark" src="/ui/showcase-dark.png" width="1280" height="900" loading="lazy" alt="The UI Showcase’s Controls page: buttons, switches, radio options, a slider and progress bars, with a component catalog and an inspector." />
          <button class="btn primary" type="button" data-showcase-src="/ui/showcase/?embed" data-pending>Start the live Showcase</button>
          <a href="/ui/showcase/" target="_blank" rel="noopener">Open it in its own tab</a>
          <p role="status" hidden></p>
        </div>
      </div>
    </section>

    <section>
      <div class="wrap">
        <div class="head">
          <h2>Platforms</h2>
          <p class="lede">The native platform ABI is still evolving, and which services are available depends on the host.</p>
        </div>
        <PlatformTable />
        <p class="note">On Android the UI toolkit is an opt-in library of the host, not yet in the app template. <a href={docsUrl('reference/ANDROID.md')}>Android reference</a></p>
      </div>
    </section>
  </div>
</StarlightPage>

<style>
  .page-intro .head .ctas { margin-top: 0; }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: var(--hx-space-6); align-items: start; }
  .sample { display: grid; gap: var(--hx-space-4); justify-items: start; }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--hx-space-5);
    align-items: stretch;
  }
  .split > :global(.figure) { display: grid; align-content: center; }
  .stack { display: grid; gap: var(--hx-space-5); align-content: start; }
  .stack p { margin: 0; }
  figure { margin: 0; }
  img { display: block; width: 100%; height: auto; border-radius: var(--hx-radius-m); border: 1px solid var(--sl-color-gray-5); }
  .window img { width: auto; max-width: 100%; }
  figcaption { margin-top: var(--hx-space-2); color: var(--sl-color-gray-3); }
  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--hx-space-6) var(--hx-space-5);
  }
  .features li { margin: 0; display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: var(--hx-space-3); align-content: start; }
  .features li > :not(.icon) { grid-column: 2; }
  .tools li { grid-template-columns: minmax(0, 1fr); border-left: 2px solid var(--sl-color-accent); padding-left: var(--hx-space-4); }
  .tools li > * { grid-column: 1; }
  .features h3 { margin: 0 0 var(--hx-space-1); font-size: 1.05rem; }
  .features p { margin: 0; color: var(--sl-color-gray-2); }
  .icon { grid-row: span 2; width: 1.5rem; height: 1.5rem; color: var(--sl-color-accent); }
  .icon :global(*) { fill: none; stroke: currentColor; stroke-width: var(--hx-stroke-icon); stroke-linecap: round; stroke-linejoin: round; }
  .showcase-light, :global([data-theme='light']) .showcase-dark { display: none; }
  :global([data-theme='light']) .showcase-light { display: block; }
  .drawing .lnk { fill: var(--sl-color-text-accent); text-decoration: underline; }
  @media (max-width: 55rem) {
    .hero, .split { grid-template-columns: minmax(0, 1fr); }
    .features { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 34rem) {
    .features { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  const start = document.querySelector<HTMLButtonElement>('[data-showcase-src]');
  if (start) {
    delete start.dataset.pending;
    start.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.title = 'UI Showcase';
      frame.src = start.dataset.showcaseSrc!;
      const wrapper = start.parentElement!;
      const status = wrapper.querySelector('[role="status"]') as HTMLElement;
      status.hidden = false;
      status.textContent = 'Loading the Showcase…';
      start.disabled = true;

      // Keep the catalog and workspace in view at narrow widths.
      const resize = new ResizeObserver(([entry]) => {
        const available = entry.contentRect.width;
        const width = Math.max(700, available);
        frame.style.width = `${width}px`;
        frame.style.zoom = String(available / width);
      });
      resize.observe(wrapper);

      function receive(event: MessageEvent) {
        if (event.origin !== location.origin || event.source !== frame.contentWindow) return;
        if (event.data === 'haxeon-showcase-ready') {
          wrapper.dataset.running = '';
          status.hidden = true;
          start.hidden = true;
        } else if (event.data === 'haxeon-showcase-failed') {
          delete wrapper.dataset.running;
          resize.disconnect();
          frame.remove();
          status.hidden = false;
          status.textContent = 'The Showcase could not load.';
          start.hidden = false;
          start.disabled = false;
          window.removeEventListener('message', receive);
        }
      }

      window.addEventListener('message', receive);
      wrapper.prepend(frame);
    });
  }
</script>

<style>
  .live-showcase { position: relative; display: grid; justify-items: start; gap: 0.75rem; margin-bottom: 2rem; }
  .live-showcase [hidden] { display: none; }
  .live-showcase [data-pending] { visibility: hidden; }
  .live-showcase img, .live-showcase :global(iframe) { width: 100%; height: auto; }
  .live-showcase :global(iframe) { aspect-ratio: 3 / 2; border: 0; min-height: 600px; }
  .live-showcase:not([data-running]) :global(iframe) { position: absolute; visibility: hidden; }
  .live-showcase[data-running] img { display: none; }
</style>
