---
import SplashPage from '../layouts/SplashPage.astro';
import Card from '../components/Card.astro';
import CodeCard from '../components/CodeCard.astro';
import FeatureList, { type Feature } from '../components/FeatureList.astro';
import LayerDiagram from '../components/LayerDiagram.astro';
import LiveEmbed from '../components/LiveEmbed.astro';
import PlatformTable from '../components/PlatformTable.astro';
import counter from '../../../docs/guides/examples/01-first-app/my_app/src/Main.hx?raw';
import { docsUrl, repositorySource } from '../../docs.mjs';
import { methodSource } from '../excerpts';

const basics = docsUrl('guides/03-ui-basics.md');
const firstApp = docsUrl('guides/01-first-app.md');
const packageDocs = repositorySource('packages/ui/README.md');
const showcase = repositorySource('packages/ui/examples/ui_showcase/README.md');
const view = methodSource(counter, 'view', 'docs/guides/examples/01-first-app/my_app/src/Main.hx');
const essentials: Feature[] = [
  { title: 'Layout and text', text: 'Rows, columns and scrolling; multilingual text with wrapping and editing.', icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M10 10v10"/>' },
  { title: 'Widgets and data', text: 'Buttons, toggles, sliders and fields; virtualized lists, trees and grids.', icon: '<rect x="3" y="8" width="18" height="8" rx="4"/><circle cx="15" cy="12" r="2.5"/>' },
  { title: 'Overlays and navigation', text: 'Dialogs, menus, popups and tooltips; tabs and sidebars.', icon: '<rect x="3" y="7" width="13" height="13" rx="2"/><path d="M8 7V4h13v13h-5"/>' },
  { title: 'Style and themes', text: 'Light and dark themes or your own tokens; borders, blurs and colour effects.', icon: '<path d="M12 3a9 9 0 1 0 0 18c1.5 0 2-1 2-2s-1-1.5-1-2.5 1-1.5 2-1.5h2a4 4 0 0 0 4-4c0-4.4-4-8-9-8z"/><circle cx="7.5" cy="11" r="1"/><circle cx="10" cy="7" r="1"/><circle cx="15" cy="7" r="1"/>' },
  { title: 'Input and motion', text: 'Pointer, keyboard and focus; gestures from taps to pinches; tweens and springs.', icon: '<path d="M5 3l6 16 2.5-6.5L20 10z"/>' },
  { title: 'Accessibility', text: 'Roles, labels, values and actions in a semantic tree, with an audit.', icon: '<circle cx="12" cy="4.5" r="1.8"/><path d="M5 8l7 1.5L19 8M12 9.5V14l-3 6M12 14l3 6"/>' },
];
const tools: Feature[] = [
  { title: 'Docking workspaces', text: 'Panels that split, tab and dock, with layouts saved between sessions.' },
  { title: 'Property inspectors', text: 'Typed editors for an object’s properties, with undoable edits.' },
  { title: 'Commands and undo', text: 'Menus, toolbars and a command palette share commands, shortcuts and an edit history.' },
  { title: 'Settings', text: 'Typed settings stored for you, with rebindable keyboard shortcuts.' },
  { title: 'Plots and viewports', text: 'Series of data, and your own GPU drawing in a viewport that pans and zooms.' },
  { title: 'Inspector and diagnostics', text: 'Inspect any view’s layout, style and semantics while the app runs.' },
];
---

<SplashPage
  title="UI"
  description="Build cross-platform apps with Haxeon’s retained, GPU-drawn UI toolkit."
>
  <section class="page-intro">
    <div class="wrap hero">
      <div class="intro">
        <h1 id="_top" tabindex="-1">A native UI toolkit, built in.</h1>
        <p class="lede">Describe a window from your app’s state, and the toolkit lays it out and draws it on the GPU, the same on every platform. Supported live edits keep your running app’s state.</p>
        <div class="ctas">
          <a class="btn primary" href={basics}>UI basics</a>
          <a class="btn ghost" href={firstApp + '#change-the-ui'}>Your first app</a>
        </div>
      </div>
      <div class="sample">
        <CodeCard code={view} lang="haxe" title="src/Main.hx" example="ui-counter" />
        <figure class="window">
          <img src="/ui/counter-window.png" width="260" height="208" alt="The counter window after two clicks: My first app, You clicked 2 times, and Click me and Reset buttons." />
          <figcaption>A <code>Signal</code> holds the count; the window redraws when it changes.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="head">
        <h2>How it works</h2>
        <p class="lede">You describe the window in code. A native core lays it out, shapes its text and draws it on the GPU.</p>
      </div>
      <div class="split wide-end">
        <LayerDiagram
          id="ui-design"
          label="Your views feed the UI framework, which hands them to the native core for layout, text and the render plan; the GPU layer draws them through the platform graphics API."
          layers={[
            { title: 'Your views' },
            { title: 'UI framework', detail: 'State · Events · Semantics' },
            { title: 'Native core', detail: 'Layout · Text · Render plan' },
            { title: { text: 'GPU layer', href: '/gpu/' } },
            { title: 'Platform graphics API' },
          ]}
        />
        <div class="stack">
          <Card>
            <h3>Views from state</h3>
            <p>Your <code>view()</code> describes the window from your app’s state. Keys tell the UI which view is which from one frame to the next, and a <code>Signal</code> marks what changed, so you never update widgets by hand.</p>
          </Card>
          <Card>
            <h3>A retained core underneath</h3>
            <p>Your code owns behaviour: state, focus, events, semantics and animation. The native core owns layout, text and drawing. It keeps a retained display list, compiles it into a render plan and repaints only what changed.</p>
          </Card>
          <Card>
            <h3>One renderer everywhere</h3>
            <p>The toolkit draws its own widgets, with text shaped by HarfBuzz, so a layout looks the same on every platform. It can own a window, or draw inside your <a href="/gpu/">GPU app</a> through a <code>UiOverlay</code>.</p>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="head">
        <h2>Every app gets</h2>
        <p class="lede">The building blocks of an interface, ready to compose.</p>
      </div>
      <FeatureList features={essentials} />
      <p class="note"><a href={basics}>Build a small app with them in UI basics</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="head">
        <h2>Built for tools and editors</h2>
        <p class="lede">The parts that editors, inspectors and other tools are made of, so you build the tool instead of its framework.</p>
      </div>
      <FeatureList features={tools} />
      <p class="note"><a href={packageDocs}>Read the UI package documentation</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="head">
        <h2>Try the Showcase</h2>
        <p class="lede">Every control and its states, text in many scripts, graphics and 3D, with an inspector for each view.</p>
      </div>
      <LiveEmbed
        src="/ui/showcase/?embed"
        title="UI Showcase"
        name="the Showcase"
        button="Start the live Showcase"
        aspect="3 / 2"
        minHeight="600px"
        minWidth={700}
      >
        <img slot="poster" class="showcase-light" src="/ui/showcase-light.webp" width="1200" height="800" loading="lazy" alt="The UI Showcase’s Controls page: buttons, switches, radio options, a slider and progress bars, beside a searchable component catalog." />
        <img slot="poster" class="showcase-dark" src="/ui/showcase-dark.webp" width="1200" height="800" loading="lazy" alt="The UI Showcase’s Controls page: buttons, switches, radio options, a slider and progress bars, beside a searchable component catalog." />
        <a href="/ui/showcase/" target="_blank" rel="noopener">Open it in its own tab</a>
      </LiveEmbed>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="head">
        <h2>Platforms</h2>
        <p class="lede">The native platform ABI is still evolving, and which services are available depends on the host.</p>
      </div>
      <PlatformTable />
      <p class="note">On Android the UI toolkit is an opt-in library of the host, not yet in the app template. <a href={docsUrl('reference/ANDROID.md')}>Android reference</a></p>
    </div>
  </section>
</SplashPage>

<style>
  .hero { --hero-columns: minmax(0, 1fr) minmax(0, 1.15fr); }
  .sample { display: grid; gap: var(--hx-space-4); justify-items: start; }
  .window img { width: auto; max-width: 100%; }
  .showcase-light, :global([data-theme='light']) .showcase-dark { display: none; }
  :global([data-theme='light']) .showcase-light { display: block; }
</style>

