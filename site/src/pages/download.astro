---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { Code } from '@astrojs/starlight/components';
import { parse } from 'yaml';
import SplashPage from '../layouts/SplashPage.astro';
import Card from '../components/Card.astro';
import PlatformIcon, { type Platform } from '../components/PlatformIcon.astro';
import StatusBadge from '../components/StatusBadge.astro';
import { docsUrl, projectRepo, repositorySource } from '../../docs.mjs';

// The newest published release, as its tag names it without the `v`; null until the first one is published.
const latest: string | null = null;

// The archives are the release workflow's build matrix, so the page lists exactly what a release builds.
const releaseWorkflow = '.github/workflows/release.yml';
const workflow = parse(readFileSync(join(__SITE_ROOT__, '..', releaseWorkflow), 'utf8'));
const builds: { platform: string; aot: boolean; experimental: boolean }[] = workflow.jobs.package.strategy.matrix.include;
const platformNames: Record<string, { name: string; architecture: string; icon: Platform }> = {
  'linux-x86_64': { name: 'Linux', architecture: 'x86-64', icon: 'linux' },
  'windows-x86_64': { name: 'Windows', architecture: 'x86-64', icon: 'windows' },
  'macos-arm64': { name: 'macOS', architecture: 'Apple Silicon', icon: 'apple' },
};
const archives = builds.map(({ platform, aot, experimental }) => {
  const names = platformNames[platform];
  if (!names) throw new Error(`${releaseWorkflow} builds ${platform}, which the download page does not name`);
  const file = `haxeon-${latest}-${platform}.${platform.startsWith('windows') ? 'zip' : 'tar.gz'}`;
  const [os, arch] = platform.split('-');
  return {
    ...names,
    os,
    arch,
    status: experimental ? ('Experimental' as const) : ('Supported' as const),
    note: aot ? 'Compiler and CLI built ahead of time.' : 'Compiler and CLI run on the included VM, so commands start more slowly.',
    href: latest && `${projectRepo}/releases/download/v${latest}/${file}`,
    file,
  };
});

const fromSource = `git clone ${projectRepo}.git
cd haxeon
./scripts/bootstrap-tools.sh     # pinned tools (Windows: scripts/setup.ps1)
cmake --preset release
cmake --build --preset release   # the VM and the runtime
./scripts/haxeon doctor          # builds the CLI, then checks your native toolchain
export PATH="$PWD/out/sdk/bin:$PATH"`;
const extension = `cd extensions/vscode
npm ci && npm run build`;
---

<SplashPage
  title="Download"
  description="Download Haxeon for Linux, macOS or Windows, or build it from source."
>
  <section class="page-intro">
    <div class="wrap">
      <div class="intro">
        <h1 id="_top" tabindex="-1">Download Haxeon</h1>
        <p class="lede">
          One archive per platform holds the <code>haxeon</code> command, the VM, the compiler, the standard library and
          the project templates. Haxeon is pre-1.0: the language, the CLI and the packages may change between releases.
        </p>
        {
          latest && (
            <div class="detected">
              <div data-detected hidden>
                <a class="btn primary" data-detected-download href="#archives">Download</a>
                <a href="#archives">Other platforms</a>
              </div>
              <p class="note" data-no-archive hidden>
                There is no archive for your system yet: <a href="#from-source">build Haxeon from source</a>.
              </p>
            </div>
          )
        }
        {
          !latest && (
            <p class="notice">
              No release has been published yet. Until the first one, <a href="#from-source">build Haxeon from source</a>:
              it takes a few minutes and gives you the same <code>haxeon</code> command.
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section id="archives">
    <div class="wrap">
      <div class="head">
        <h2>Release archives</h2>
        <p class="lede">
          Unpack an archive anywhere and put its <code>bin</code> directory on your <code>PATH</code>.{' '}
          <code>haxeon doctor</code> then checks the C toolchain and CMake that app builds need.
        </p>
      </div>
      <ul class="grid three archives" aria-label="Release archives">
        {
          archives.map(({ name, architecture, icon, os, arch, status, note, href, file }) => (
            <li data-os={os} data-arch={arch} data-label={`${name} (${architecture})`}>
              <Card>
                <span class="yours" hidden>Your system</span>
                <div class="platform">
                  <PlatformIcon platform={icon} />
                  <div>
                    <h3>{name}</h3>
                    <span class="architecture">{architecture}</span>
                  </div>
                  <StatusBadge status={status} />
                </div>
                <p class="detail">{note}</p>
                {href ? (
                  <div class="get">
                    <a class="btn primary" href={href}>Download</a>
                    <span class="file">{file}</span>
                  </div>
                ) : (
                  <span class="pending">Not yet published</span>
                )}
              </Card>
            </li>
          ))
        }
      </ul>
      <p class="note">
        On other machines, including Linux arm64 and Intel Macs, build from source. <a
          href={docsUrl('reference/RELEASES.md')}>What an archive holds</a
        > · <a href={`${projectRepo}/releases`}>All releases</a>
      </p>
    </div>
  </section>

  <section id="from-source">
    <div class="wrap">
      <div class="head">
        <h2>Build from source</h2>
        <p class="lede">
          You need Git, CMake and a C/C++ toolchain. The setup script installs the pinned Haxe, HashLink and Ninja tools
          inside the checkout.
        </p>
      </div>
      <Code code={fromSource} lang="sh" frame="terminal" />
      <p class="note">
        Then <a href={docsUrl('guides/00-get-started.md')}>create your first app</a>. Working on Haxeon itself? See <a
          href={repositorySource('docs/DEVELOPMENT.md')}>the development guide</a
        >.
      </p>
    </div>
  </section>

  <section id="editor">
    <div class="wrap">
      <div class="head">
        <h2>Editor support</h2>
        <p class="lede">
          The VS Code extension adds the language server, the debugger and the realtime profiler. It is not in the
          Marketplace yet: build it from the checkout and run it from VS Code.
        </p>
      </div>
      <Code code={extension} lang="sh" frame="terminal" />
      <p class="note">
        Then open <code>extensions/vscode</code> in VS Code and press F5. The debugger runs on x64 Linux, Windows and
        Intel macOS. <a href={repositorySource('extensions/vscode/README.md')}>Extension guide</a>
      </p>
    </div>
  </section>
</SplashPage>

<script>
  // Marks the visitor's platform among the archives, first, and with a release names it on the intro's button. Without
  // JavaScript, or on a system it cannot tell, the page lists every archive as it is.
  type System = { os?: string; arch?: string };

  async function detect(): Promise<System> {
    const agent = navigator.userAgent;
    const hints = (navigator as Navigator & { userAgentData?: any }).userAgentData;
    let os: string | undefined;
    let arch: string | undefined;
    if (hints) {
      os = ({ Windows: 'windows', macOS: 'macos', Linux: 'linux', Android: 'android', iOS: 'ios', 'Chrome OS': 'chromeos' } as Record<string, string>)[hints.platform];
      try {
        const { architecture, bitness } = await hints.getHighEntropyValues(['architecture', 'bitness']);
        arch = architecture === 'arm' ? 'arm64' : architecture === 'x86' && bitness === '64' ? 'x86_64' : undefined;
      } catch {}
    }
    os ??= /Android/.test(agent)
      ? 'android'
      : /iPhone|iPad|iPod/.test(agent) || (/Macintosh/.test(agent) && navigator.maxTouchPoints > 1)
        ? 'ios'
        : /Windows/.test(agent)
          ? 'windows'
          : /Macintosh|Mac OS X/.test(agent)
            ? 'macos'
            : /CrOS/.test(agent)
              ? 'chromeos'
              : /Linux|X11/.test(agent)
                ? 'linux'
                : undefined;
    arch ??= /aarch64|arm64/i.test(agent) ? 'arm64' : /x86_64|x64|Win64|WOW64|amd64/i.test(agent) ? 'x86_64' : undefined;
    return { os, arch };
  }

  function show({ os, arch }: System) {
    const list = document.querySelector<HTMLElement>('.archives')!;
    // Browsers report every Mac as Intel, so a Mac matches the macOS archive whatever it says.
    const match = [...list.querySelectorAll<HTMLElement>(':scope > li')].find(
      (item) => item.dataset.os === os && (os === 'macos' || !arch || item.dataset.arch === arch),
    );
    if (match) {
      match.dataset.yours = '';
      match.querySelector<HTMLElement>('.yours')!.hidden = false;
      list.prepend(match);
      // The visitor's archive keeps the primary button; the others step back.
      for (const other of list.querySelectorAll<HTMLElement>(':scope > li:not([data-yours]) .btn.primary'))
        other.classList.replace('primary', 'ghost');
    }
    const detected = document.querySelector<HTMLElement>('[data-detected]');
    const download = match?.querySelector<HTMLAnchorElement>('a.btn');
    if (detected && download) {
      const button = detected.querySelector<HTMLAnchorElement>('[data-detected-download]')!;
      button.href = download.href;
      button.textContent = `Download for ${match!.dataset.label}`;
      detected.hidden = false;
    } else if (os) {
      const none = document.querySelector<HTMLElement>('[data-no-archive]');
      if (none) none.hidden = false;
    }
  }

  detect().then(show);
</script>

<style>
  .archives {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .platform {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--hx-space-3);
    --platform-icon-size: 2rem;
  }
  .platform h3 {
    margin: 0;
  }
  .architecture {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .archives > li {
    display: grid;
  }
  /* The note takes the slack, so the cards' buttons line up; the visitor's card has its label above. */
  .archives :global(.card) {
    grid-template-rows: auto 1fr auto;
  }
  .archives > li[data-yours] :global(.card) {
    grid-template-rows: auto auto 1fr auto;
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 1px var(--sl-color-accent);
  }
  .yours {
    font: 600 var(--sl-text-2xs) var(--sl-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-text-accent);
  }
  .archives :global(.card) > .yours[hidden] {
    display: none;
  }
  .detected > [data-detected] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--hx-space-4);
  }
  .detected > [hidden] {
    display: none;
  }
  .get {
    display: grid;
    justify-items: start;
    gap: var(--hx-space-1);
  }
  .file {
    font: var(--sl-text-xs) var(--sl-font-mono);
    color: var(--sl-color-gray-3);
    overflow-wrap: anywhere;
  }
  .pending {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .notice {
    padding: var(--hx-space-3) var(--hx-space-4);
    border: 1px solid var(--sl-color-gray-5);
    border-left: 3px solid var(--sl-color-accent);
    border-radius: var(--hx-radius-s);
    background: var(--sl-color-bg-sidebar);
  }
</style>
