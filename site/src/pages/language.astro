---
import { getCollection } from 'astro:content';
import Marketing from '../layouts/Marketing.astro';
import LanguageTour from '../components/home/LanguageTour.astro';
import { docsUrl } from '../../docs.mjs';

const lessons = (
  await getCollection('docs', ({ id, data }) => (id === 'learn' || id.startsWith('learn/')) && !data.draft)
).sort(
  (a, b) =>
    (a.data.sidebar?.order ?? Infinity) - (b.data.sidebar?.order ?? Infinity) || a.id.localeCompare(b.id),
);
---

<Marketing title="Language">
  <section class="marketing-page paper">
    <div class="wrap head">
      <h1>Language</h1>
      <p class="lede">
        Static types with inference, value types, pattern matching, null safety and deterministic cleanup.
      </p>
      {
        lessons.length ? (
          <div class="prose">
            <h2>Learn the language</h2>
            <ul>
              {lessons.map(({ id, data }) => (
                <li>
                  <a href={`/${id}/`}>{data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <p>
            <a href={docsUrl('reference/LANGUAGE_SUPPORT.md')}>Read the language reference</a>
          </p>
        )
      }
    </div>
  </section>
  <LanguageTour />
</Marketing>
