---
import SplashPage from '../layouts/SplashPage.astro';
import Hero from '../components/sections/Hero.astro';
import Apps from '../components/sections/Apps.astro';
import LanguageTour from '../components/sections/LanguageTour.astro';
import Interop from '../components/sections/Interop.astro';
import Outputs from '../components/sections/Outputs.astro';
import Toolchain from '../components/sections/Toolchain.astro';
import OtherUses from '../components/sections/OtherUses.astro';
import Start from '../components/sections/Start.astro';

const title = 'A language and runtime for cross-platform apps and tools.';
const description =
  "Develop on a live VM that keeps your program's state as you edit, ship one codebase as native executables or WebAssembly, and call C and C++ directly.";
---

<SplashPage {title} {description}>
  <Hero {title} {description} />
  <Apps />
  <LanguageTour eyebrow="The language" />
  <Interop />
  <Outputs />
  <Toolchain />
  <OtherUses />
  <Start />
</SplashPage>
