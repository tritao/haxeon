---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Apps from '../components/home/Apps.astro';
import Outputs from '../components/home/Outputs.astro';
import OtherUses from '../components/home/OtherUses.astro';
import { docsUrl } from '../../docs.mjs';
---

<StarlightPage
  frontmatter={{
    title: 'Build',
    template: 'splash',
    prev: false,
    next: false,
    description: 'Develop on the live VM and ship cross-platform apps with Haxeon.',
  }}
>
  <div class="landing-content">
    <section class="page-intro paper">
      <div class="wrap head">
        <h1 id="_top" tabindex="-1">Build apps with Haxeon</h1>
        <p class="lede">
          Develop a cross-platform UI on the live VM, then ship it for the platforms you support.
        </p>
        <p><a href={docsUrl('guides/01-first-app.md')}>Build your first app</a></p>
      </div>
    </section>
    <Apps />
    <Outputs />
    <OtherUses />
  </div>
</StarlightPage>
