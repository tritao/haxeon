---
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { docsUrl, sourceRef } from '../../docs.mjs';

const { docs = false } = Astro.props;
const version =
  process.env.HAXEON_SITE_MAIN_URL && sourceRef !== 'main'
    ? { label: sourceRef, main: process.env.HAXEON_SITE_MAIN_URL }
    : { label: sourceRef };

const nav = [
  ['Language', '/language/'],
  ['Build', '/build/'],
  ['Docs', docsUrl('guides/README.md')],
  ['Examples', '/examples/'],
  ['About', '/about/'],
];
const getStarted = docsUrl('guides/00-get-started.md');
---

<div class:list={['site-nav', { 'docs-nav': docs }]}>
  <a class="wordmark" href="/" aria-label="Haxeon home">Haxeon</a>
  <nav class="wide-nav" aria-label="Main">
    {
      nav.map(([label, href]) => (
        <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
  <details class="mobile-nav">
    <summary>Site</summary>
    <nav aria-label="Main">
      {
        nav.map(([label, href]) => (
          <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
  </details>
  <div class="actions">
    {docs && <Search />}
    {
      docs && (
        <span class="version">
          {version.label}
          {version.main && (
            <>
              {' '}
              · <a href={version.main}>main</a>
            </>
          )}
        </span>
      )
    }
    <ThemeSelect />
    <a class="get-started" href={getStarted}>Get started</a>
  </div>
</div>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-inline: auto;
    max-width: 1200px;
    min-height: var(--sl-nav-height);
    padding-inline: var(--space-4);
  }
  .docs-nav {
    max-width: none;
    padding: 0;
  }
  .wordmark {
    color: var(--ink);
    font: 800 1.35rem/1 var(--display);
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: var(--space-5);
  }
  nav a,
  summary {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--indigo);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-inline-start: auto;
  }
  .version {
    color: var(--slate);
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .get-started {
    border-radius: var(--radius-pill);
    background: var(--indigo);
    color: var(--indigo-ink);
    padding: 0.5rem 1rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .mobile-nav {
    display: none;
    position: relative;
  }
  .mobile-nav nav {
    position: absolute;
    inset-block-start: calc(100% + var(--space-3));
    inset-inline-start: 0;
    z-index: 1;
    display: grid;
    gap: var(--space-2);
    min-width: 9rem;
    padding: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
  }
  summary {
    cursor: pointer;
  }
  @media (max-width: 66rem) {
    .docs-nav .wide-nav {
      display: none;
    }
    .docs-nav .mobile-nav {
      display: block;
    }
  }
  @media (max-width: 50rem) {
    .site-nav {
      gap: var(--space-2);
    }
    .wide-nav {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
    .docs-nav {
      padding-inline-end: 2.75rem;
    }
    .docs-nav .version {
      display: none;
    }
  }
  @media (max-width: 28rem) {
    .actions {
      gap: var(--space-1);
    }
    .get-started {
      padding: var(--space-2);
      font-size: 0.8rem;
    }
    .docs-nav {
      gap: var(--space-1);
    }
    .docs-nav :global(starlight-theme-select) {
      display: none;
    }
  }
</style>
