---
import PlatformIcon, { type Platform } from './PlatformIcon.astro';
import StatusBadge, { type Status } from './StatusBadge.astro';

const platforms: { platform: string; detail?: string; icon: Platform; status: Status; live: string }[] = [
  {
    platform: 'Linux',
    detail: 'x86-64, arm64',
    icon: 'linux',
    status: 'Supported',
    live: 'Yes',
  },
  {
    platform: 'macOS',
    detail: 'Intel, Apple Silicon',
    icon: 'apple',
    status: 'Supported',
    live: 'Yes',
  },
  {
    platform: 'Windows',
    detail: 'x86-64',
    icon: 'windows',
    status: 'Supported',
    live: 'Yes',
  },
  {
    platform: 'Android',
    detail: 'arm64-v8a, x86_64; debug APKs',
    icon: 'android',
    status: 'Preview',
    live: 'Yes',
  },
  {
    platform: 'Web',
    detail: 'WebAssembly',
    icon: 'webassembly',
    status: 'Experimental',
    live: 'Not yet',
  },
  {
    platform: 'iOS',
    icon: 'apple',
    status: 'In progress',
    live: 'Not yet',
  },
];
---

<div class="table-scroll">
  <table aria-label="Platforms">
    <thead>
      <tr
        ><th scope="col">Platform</th><th scope="col">Status</th><th scope="col">Live editing</th
        ></tr
      >
    </thead>
    <tbody>
      {
        platforms.map(({ platform, detail, icon, status, live }) => (
          <tr>
            <th scope="row">
              <span class="platform">
                <PlatformIcon platform={icon} />
                <span>{platform}{detail && <small>{detail}</small>}</span>
              </span>
            </th>
            <td>
              <StatusBadge status={status} />
            </td>
            <td>{live}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .platform {
    display: inline-flex;
    align-items: center;
    gap: var(--hx-space-3);
  }
  .platform :global(.platform-icon) {
    color: var(--sl-color-gray-3);
  }
</style>
