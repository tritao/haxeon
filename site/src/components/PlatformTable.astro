---
import StatusBadge, { type Status } from './StatusBadge.astro';

const platforms: { platform: string; icon: string; status: Status; live: string }[] = [
  {
    platform: 'Linux (x86-64, arm64)',
    icon: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M7 9l3 2-3 2M12 13h4M9 20h6"/>',
    status: 'Supported',
    live: 'Yes',
  },
  {
    platform: 'macOS (Intel, Apple Silicon)',
    icon: '<path d="M5 6h14v10H5z"/><path d="M2 19h20"/>',
    status: 'Supported',
    live: 'Yes',
  },
  {
    platform: 'Windows (x86-64)',
    icon: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M3 8h18M9 20h6"/>',
    status: 'Supported',
    live: 'Yes',
  },
  {
    platform: 'Android (arm64-v8a, x86_64)',
    icon: '<rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/>',
    status: 'Supported',
    live: 'Yes',
  },
  {
    platform: 'Web (WebAssembly)',
    icon: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/>',
    status: 'Experimental',
    live: 'Not yet',
  },
  {
    platform: 'iOS',
    icon: '<rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/>',
    status: 'In progress',
    live: 'Not yet',
  },
];
---

<div class="plat">
  <table aria-label="Platforms">
    <thead>
      <tr
        ><th scope="col">Platform</th><th scope="col">Status</th><th scope="col">Live editing</th
        ></tr
      >
    </thead>
    <tbody>
      {
        platforms.map(({ platform, icon, status, live }) => (
          <tr>
            <td>
              <span class="pn">
                <svg class="pico" viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />
                {platform}
              </span>
            </td>
            <td>
              <StatusBadge status={status} />
            </td>
            <td>{live}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.92rem;
  }
  th,
  td {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  th {
    font: 600 0.75rem var(--sl-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .pn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .pico {
    width: 20px;
    height: 20px;
    flex: none;
    color: var(--sl-color-gray-3);
  }
  .pico :global(*) {
    fill: none;
    stroke: currentColor;
    stroke-width: var(--hx-stroke-icon);
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .plat {
    overflow-x: auto;
  }
</style>
