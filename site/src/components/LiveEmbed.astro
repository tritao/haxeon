---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  /** The page to embed; it loads only when the visitor starts it. */
  src: string;
  /** The iframe's accessible title. */
  title: string;
  /** What the status line calls it, as in "Loading the Showcase…". */
  name: string;
  button: string;
  aspect: string;
  minHeight?: string;
  /** Lay the page out at least this wide, scaled down to fit narrower columns. */
  minWidth?: number;
}
const { src, title, name, button, aspect, minHeight = '0px', minWidth } = Astro.props;
const capitalized = name.charAt(0).toUpperCase() + name.slice(1);
// The embeds are built into public/ before the site; a site built without one shows only its poster.
const built = existsSync(join(__SITE_ROOT__, 'public', new URL(src, 'file:').pathname));
---

<live-embed
  data-src={src}
  data-title={title}
  data-min-width={minWidth}
  data-loading={`Loading ${name}…`}
  data-failed={`${capitalized} could not load.`}
  style={`--embed-aspect: ${aspect}; --embed-min-height: ${minHeight}`}
>
  <slot name="poster" />
  {built && <button class="btn primary" type="button" data-start>{button}</button>}
  <p role="status" hidden></p>
  <slot />
</live-embed>

<script>
  // The SDK's web host, and the UI Showcase's shell, post this when the app is ready or has failed.
  const appState = (data: any): string | undefined => (data?.type === 'haxeon-app' ? data.state : undefined);

  class LiveEmbed extends HTMLElement {
    connectedCallback() {
      const start = this.querySelector<HTMLButtonElement>('[data-start]');
      if (!start) return;
      const status = this.querySelector<HTMLElement>('[role="status"]')!;
      const { src, title, minWidth, loading, failed: failedText } = this.dataset;

      start.addEventListener('click', () => {
        const frame = document.createElement('iframe');
        frame.title = title!;
        // An embed that has light and dark palettes starts in the page's.
        const url = new URL(src!, location.href);
        url.searchParams.set('theme', document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light');
        frame.src = url.href;
        start.disabled = true;
        status.hidden = false;
        status.textContent = loading!;

        const resize = minWidth
          ? new ResizeObserver(([entry]) => {
              const available = entry.contentRect.width;
              const width = Math.max(Number(minWidth), available);
              frame.style.width = `${width}px`;
              frame.style.zoom = String(available / width);
            })
          : undefined;
        resize?.observe(this);

        const finish = () => {
          window.clearTimeout(timeout);
          window.removeEventListener('message', receive);
        };

        const fail = () => {
          finish();
          resize?.disconnect();
          delete this.dataset.running;
          frame.remove();
          status.hidden = false;
          status.textContent = failedText!;
          start.hidden = false;
          start.disabled = false;
        };

        const receive = (event: MessageEvent) => {
          if (event.origin !== location.origin || event.source !== frame.contentWindow) return;
          const state = appState(event.data);
          if (state === 'ready') {
            finish();
            this.dataset.running = '';
            status.hidden = true;
            start.hidden = true;
            frame.contentDocument?.querySelector('canvas')?.focus();
          } else if (state === 'failed') {
            fail();
          }
        };

        // A failed download or start reports itself at once; this only catches an app that never reports. The Showcase's
        // few megabytes, one file of them its Wasm, take over a minute on a slow connection, so the wait allows three.
        const timeout = window.setTimeout(fail, 180_000);
        window.addEventListener('message', receive);
        this.prepend(frame);
      });
    }
  }

  customElements.define('live-embed', LiveEmbed);
</script>

<style>
  live-embed { position: relative; display: grid; justify-items: start; gap: var(--hx-space-3); }
  live-embed [hidden] { display: none; }
  live-embed :global(iframe) {
    width: 100%;
    height: auto;
    aspect-ratio: var(--embed-aspect);
    min-height: var(--embed-min-height);
    border: 0;
    border-radius: var(--hx-radius-m);
  }
  live-embed:not([data-running]) :global(iframe) { position: absolute; visibility: hidden; }
  live-embed[data-running] > :global(img) { display: none; }
</style>
