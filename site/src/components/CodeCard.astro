---
import { Code } from '@astrojs/starlight/components';

interface Props {
  code: string;
  lang: string;
  title?: string;
  output?: string;
  command?: string;
  example?: string;
}
const { code, lang, title, output, command, example } = Astro.props;
const prompt = command ? `$ ${command}\n` : undefined;
---

<div class="code-card code-panel" data-example={example}>
  {title && <div class="bar">{title}</div>}
  <Code {code} {lang} frame="none" />
  {
    output !== undefined && (
      <pre
        class="output-pane"
        aria-label="Program output">{prompt && <span class="p" data-prompt>{prompt}</span>}{output}</pre>
    )
  }
</div>

<style>
  .code-card {
    border-radius: var(--hx-radius-m);
    overflow: hidden;
    min-width: 0;
  }
  .output-pane {
    margin: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    tab-size: 2;
    border-top: 1px dashed var(--hx-code-divider);
  }
  .output-pane .p {
    color: var(--hx-code-muted);
  }
</style>
