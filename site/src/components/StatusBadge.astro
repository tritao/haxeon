---
export type Status = 'Supported' | 'Preview' | 'Experimental' | 'In progress' | 'Planned';

interface Props {
  status: Status;
}
const { status } = Astro.props;
---

<span class:list={['badge', status.toLowerCase().replace(' ', '-')]}><slot>{status}</slot></span>

<style>
  .badge {
    font: 600 var(--sl-text-xs) var(--sl-font-mono);
    padding: 2px 8px;
    border-radius: var(--hx-radius-pill);
    white-space: nowrap;
  }
  .supported {
    background: var(--sl-color-green-low);
    color: var(--sl-color-green-high);
  }
  .preview,
  .experimental {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }
  .in-progress,
  .planned {
    border: 1px dashed var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
  }
</style>
