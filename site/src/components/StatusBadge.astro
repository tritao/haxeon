---
export type Status = 'Supported' | 'Experimental' | 'In progress';

interface Props {
  status: Status;
}
const { status } = Astro.props;
const state = { Supported: 'ok', Experimental: 'exp', 'In progress': 'plan' }[status];
---

<span class:list={['st', state]}><slot>{status}</slot></span>

<style>
  .st {
    font: 600 0.78rem var(--sl-font-mono);
    padding: 2px 8px;
    border-radius: var(--hx-radius-pill);
    white-space: nowrap;
  }
  .ok {
    background: var(--sl-color-green-low);
    color: var(--sl-color-green-high);
  }
  .exp {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }
  .plan {
    border: 1px dashed var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
  }
</style>
