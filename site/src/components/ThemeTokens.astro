---
import tokens from '../styles/tokens.json';

const declarations = (values: Record<string, string>) =>
  Object.entries(values)
    .map(([name, value]) => `--${name}:${value};`)
    .join('');

const css = `
  :root { ${declarations(tokens.shared)} ${declarations(tokens.light)} }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) { ${declarations(tokens.dark)} color-scheme: dark; }
  }
  :root[data-theme="dark"] { ${declarations(tokens.dark)} color-scheme: dark; }
`;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap"
/>
<style is:inline set:html={css}></style>
