---
interface Props {
  as?: 'div' | 'li';
  compact?: boolean;
}
const { as: Tag = 'div', compact = false } = Astro.props;
---

<Tag class:list={['card', { compact }]}><slot /></Tag>

<style>
  .card {
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--hx-radius-m);
    padding: var(--hx-space-5);
    display: grid;
    gap: 10px;
    align-content: start;
    min-width: 0;
  }

  .compact {
    padding: 18px;
  }
</style>
