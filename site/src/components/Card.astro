---
interface Props {
  as?: 'div' | 'li';
}
const { as: Tag = 'div' } = Astro.props;
---

<Tag class="card"><slot /></Tag>

<style>
  .card {
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--hx-radius-m);
    padding: var(--hx-space-5);
    display: grid;
    gap: var(--hx-space-3);
    align-content: start;
    min-width: 0;
  }
</style>
