---
interface Props {
  spaced?: boolean;
}
const { spaced = false } = Astro.props;
---

<div class:list={['figure', 'paper', { spaced }]}><slot /></div>

<style>
  .figure :global(.drawing) {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
  }
  .figure :global(.drawing text) {
    font-family: var(--sl-font-mono);
    font-size: 13px;
    fill: var(--sl-color-gray-3);
  }
  .figure :global(.drawing .ttl) {
    fill: var(--sl-color-white);
    font-weight: 600;
  }
  .figure :global(.drawing .ln) {
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.4;
    fill: none;
  }
  .figure :global(.drawing .acc) {
    stroke: var(--sl-color-accent);
    stroke-width: var(--hx-stroke-icon);
    fill: none;
  }
  .figure :global(.drawing .accf) {
    fill: var(--sl-color-accent);
  }
  .figure :global(.drawing .box) {
    fill: var(--sl-color-bg-sidebar);
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.4;
  }
  .figure :global(.drawing .codebox) {
    fill: var(--sl-color-bg-inline-code);
    stroke: none;
  }
  .figure :global(.drawing .codet) {
    fill: var(--hx-code-fg);
  }
  .figure {
    margin-top: var(--hx-space-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--hx-radius-m);
    padding: 18px;
    overflow-x: auto;
  }
  .spaced {
    margin-block: 0 20px;
  }
</style>
