---
import Command from './Command.astro';
import PlatformTable from './PlatformTable.astro';
import { docsUrl } from '../../../docs.mjs';
---

<section>
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">One codebase, three outputs</span>
      <h2>Develop live, ship native or WebAssembly.</h2>
    </div>
    <div class="figure paper" style="margin-top:0;margin-bottom:20px">
      <svg
        class="drawing"
        viewBox="0 0 1000 190"
        role="img"
        aria-label="One Main.hx builds three outputs: the VM, a native executable and a WebAssembly module"
      >
        <defs>
          <marker
            id="ah3"
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="7"
            markerHeight="7"
            orient="auto-start-reverse"
          >
            <path d="M0 0L10 5L0 10z" class="accf"></path>
          </marker>
        </defs>
        <rect x="430" y="12" width="140" height="38" rx="6" class="codebox"></rect><text
          x="500"
          y="36"
          text-anchor="middle"
          class="codet"
        >
          Main.hx
        </text>
        <path d="M500 50C500 95 170 90 170 136" class="ln" marker-end="url(#ah3)"></path>
        <path d="M500 50V136" class="ln" marker-end="url(#ah3)"></path>
        <path d="M500 50C500 95 830 90 830 136" class="ln" marker-end="url(#ah3)"></path>
        <rect x="70" y="140" width="200" height="38" rx="6" class="box"></rect><text
          x="170"
          y="164"
          text-anchor="middle"
          class="ttl"
        >
          JIT VM
        </text>
        <path d="M252 150a7 7 0 1 1-4 12" class="acc" marker-end="url(#ah3)"></path>
        <rect x="400" y="140" width="200" height="38" rx="6" class="box"></rect><text
          x="500"
          y="164"
          text-anchor="middle"
          class="ttl"
        >
          native executable
        </text>
        <rect x="730" y="140" width="200" height="38" rx="6" class="box"></rect><text
          x="830"
          y="164"
          text-anchor="middle"
          class="ttl"
        >
          .wasm module
        </text>
        <text x="196" y="106">live edits</text><text x="512" y="106">ahead of time, via C</text><text
          x="742"
          y="106"
        >
          WebAssembly
        </text>
      </svg>
    </div>
    <div class="outputs">
      <div>
        <h3>Develop on the VM</h3><Command command="haxeon run --watch --live" /><p
          class="lede"
          style="font-size:0.95rem"
        >
          A fast JIT VM that starts at once and takes your edits while the program runs.
        </p>
      </div>
      <div>
        <h3>Ship a native executable</h3><Command command="haxeon build --build-mode=release" /><p
          class="lede"
          style="font-size:0.95rem"
        >
          Compiled ahead of time through C into one executable, with the VM linked in.
        </p>
      </div>
      <div>
        <h3>Build WebAssembly</h3><Command command="haxeon build --target wasm32" /><p
          class="lede"
          style="font-size:0.95rem"
        >
          A .wasm module, not a JavaScript bundle. Experimental.
        </p>
      </div>
    </div>
    <PlatformTable />
    <p class="note"><a href={docsUrl('guides/05-shipping.md')}>Read the shipping guide</a></p>
  </div>
</section>
