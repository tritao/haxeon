---
import CodeLines from './CodeLines.astro';

interface Props {
  name: string;
  code: string;
  output: string;
  command?: string;
}

const { name, code, output, command } = Astro.props;
const lines = code.split('\n').map((text) => ({ text }));
const prompt = `$ ${command}\n`;
---

<div class="term" data-example={name}>
  {command && <div class="bar">{name}.hx</div>}
  <pre aria-label="Haxeon source"><code><CodeLines lines={lines} /></code></pre>
  <pre
    class="out"
    aria-label="Program output">{command && <span class="p" data-prompt>{prompt}</span>}{output}</pre>
</div>
