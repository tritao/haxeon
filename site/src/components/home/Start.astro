---
import Command from './Command.astro';
import { docsUrl } from '../../../docs.mjs';
---

<section class="start" id="start">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">Start building</span>
      <h2>Three steps to a running app.</h2>
    </div>
    <ol>
      <li>
        <h3>Install</h3><p class="lede" style="font-size:0.95rem">
          Unpack <a href={docsUrl('reference/RELEASES.md')}>a release</a> and put its <code>bin</code> on your
          PATH. <code>haxeon doctor</code> checks your C toolchain.
        </p>
      </li>
      <li>
        <h3>Create</h3><Command command="haxeon create my_app" /><p class="lede" style="font-size:0.95rem">
          A windowed app for Linux, macOS and Windows.
        </p>
      </li>
      <li>
        <h3>Run and edit</h3><Command command="haxeon run --watch --live" /><p
          class="lede"
          style="font-size:0.95rem"
        >
          Run from <code>my_app</code>. Change <code>src/Main.hx</code> and watch the app update.
        </p>
      </li>
    </ol>
    <div class="ctas">
      <a class="btn primary" href={docsUrl('guides/00-get-started.md')}>Get started</a><a
        class="btn ghost"
        href="/examples/"
      >
        Browse examples
      </a>
    </div>
  </div>
</section>
