---
import Command from './Command.astro';
import { docsUrl } from '../../../docs.mjs';
---

<section>
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">What else you can build</span>
      <h2>The same language, beyond apps.</h2>
    </div>
    <div class="tiles">
      <div>
        <h3><a href={docsUrl('reference/CLI.md') + '#create'}>Tools</a></h3><Command
          command="haxeon create my_tool -t console"
        /><p>Command-line programs, built into one executable.</p>
      </div>
      <div>
        <h3><a href="/examples/#games-and-3d">Games and 3D</a></h3><div class="cmd">
          gpu · audio · animation
        </div><p>Tune a game's logic while you play it.</p>
      </div>
      <div>
        <h3><a href={docsUrl('reference/CLI.md') + '#scripts'}>Scripts</a></h3><Command
          command="haxeon script.hx"
        /><p>One file, no project, started at once.</p>
      </div>
      <div>
        <h3>Embedding</h3><div class="cmd">C or C++ host</div><p>
          Run Haxeon inside an existing application. Guide forthcoming.
        </p>
      </div>
    </div>
  </div>
</section>
