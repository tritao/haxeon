---
import Card from '../Card.astro';
import Command from '../Command.astro';
import { docsUrl } from '../../../docs.mjs';
---

<section>
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">What else you can build</span>
      <h2>The same language, beyond apps.</h2>
    </div>
    <div class="grid four">
      <Card>
        <h3><a href={docsUrl('reference/cli/project.md') + '#create'}>Tools</a></h3><Command
          command="haxeon create my_tool -t console"
        /><p class="detail">Command-line programs, built into one executable.</p>
      </Card>
      <Card>
        <h3><a href="/gpu/">Games and 3D</a></h3><div class="cmd">
          gpu · audio · animation
        </div><p class="detail">Tune a game's logic while you play it.</p>
      </Card>
      <Card>
        <h3><a href={docsUrl('reference/cli/build-run.md') + '#scripthx'}>Scripts</a></h3><Command
          command="haxeon script.hx"
        /><p class="detail">One file, no project: run it directly.</p>
      </Card>
      <Card>
        <h3>Embedding</h3><div class="cmd">C or C++ host</div><p class="detail">
          Planned: run Haxeon inside an existing application, such as a game's scripting layer.
        </p>
      </Card>
    </div>
  </div>
</section>
