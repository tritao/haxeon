---
import { Code } from '@astrojs/starlight/components';
import initial from '../../../../docs/guides/examples/02-live-editing/my_app/src/Main.hx?raw';
import edited from '../../../../docs/guides/examples/02-live-editing/steps/1-logic-patch/Main.hx?raw';
import { methodSource } from '../../excerpts';

// The first edit of the live editing guide, which its test applies to a running app as a patch.
const example = 'docs/guides/examples/02-live-editing/';
const before = methodSource(initial, 'view', example + 'my_app/src/Main.hx').split('\n');
const after = methodSource(edited, 'view', example + 'steps/1-logic-patch/Main.hx').split('\n');

/** The lines of `a` and `b` in order, each kept, deleted or added, from their longest common subsequence. */
function lineDiff(a: string[], b: string[]): ['' | 'del' | 'add', string][] {
  const common = Array.from({ length: a.length + 1 }, () => new Array<number>(b.length + 1).fill(0));
  for (let i = a.length - 1; i >= 0; i--)
    for (let j = b.length - 1; j >= 0; j--)
      common[i][j] = a[i] === b[j] ? common[i + 1][j + 1] + 1 : Math.max(common[i + 1][j], common[i][j + 1]);
  const lines: ['' | 'del' | 'add', string][] = [];
  let i = 0, j = 0;
  while (i < a.length || j < b.length) {
    if (i < a.length && j < b.length && a[i] === b[j]) {
      lines.push(['', a[i++]]);
      j++;
    } else if (j === b.length || (i < a.length && common[i + 1][j] >= common[i][j + 1])) lines.push(['del', a[i++]]);
    else lines.push(['add', b[j++]]);
  }
  return lines;
}
const diff = lineDiff(before, after);
if (!diff.some(([change]) => change)) throw new Error(`steps/1-logic-patch no longer changes view() in ${example}`);

// What the mock window shows of each version, as its source writes it; a guide edit that changes these must update
// the demo too. The script below renders the counter and button from the same table.
const field = 'Main.count.value';
const count = '${' + field + '}';
const versions = [
  { source: initial, counter: `You clicked ${count} times`, button: 'Click me', step: 1 },
  { source: edited, counter: `Count: ${count}`, button: 'Add 2', step: 2 },
];
const shown: [string, string[]][] = [
  [initial, ['options.title = "My App"', 'new Text("My first app")', '"Reset"']],
  ...versions.map(({ source, counter, button, step }): [string, string[]] => [source, [counter, `"${button}"`, `${field} + ${step}`]]),
];
for (const [source, texts] of shown)
  for (const text of texts)
    if (!source.includes(text)) throw new Error(`The live demo shows ${text}, which ${example} no longer has`);
const views = versions.map(({ counter, button, step }) => ({ counter: counter.split(count), button, step }));
---

<live-edit-demo class="demo" data-versions={JSON.stringify(views)}>
  <div class="editor code-panel">
    <div class="bar"><span>src/Main.hx</span><span data-version>version 1</span></div>
    {
      [1, 2].map((version) => {
        const lines = diff.filter(([change]) => version === 2 || change !== 'add');
        return (
          <div data-code={version} hidden={version !== 1}>
            <Code
              code={lines.map(([, text]) => text).join('\n')}
              lang="haxe"
              frame="none"
              wrap
              preserveIndent
              ins={version === 2 ? lines.flatMap(([change], i) => (change === 'add' ? [i + 1] : [])) : []}
              del={version === 2 ? lines.flatMap(([change], i) => (change === 'del' ? [i + 1] : [])) : []}
            />
          </div>
        );
      })
    }
  </div>
  <div class="app">
    <div class="window">
      <div class="titlebar">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span><span>My App</span>
      </div>
      <div class="body">
        <p>My first app</p>
        <p data-count>{views[0].counter.join('0')}</p>
        <button type="button" data-add>{views[0].button}</button>
        <button type="button" data-reset>Reset</button>
      </div>
    </div>
    <div class="controls">
      <button class="btn primary" data-apply type="button">Apply the edit</button>
      <button class="reject" data-reject type="button">Try a broken edit</button>
    </div>
    <span class="status" role="status">Running version 1</span>
    <p class="demo-note">Interactive preview of a Haxeon live edit.</p>
  </div>
</live-edit-demo>

<script>
  class LiveEditDemo extends HTMLElement {
    connectedCallback() {
      const windowPanel = this.querySelector('.window')!;
      const label = this.querySelector('[data-count]')!;
      const add = this.querySelector<HTMLButtonElement>('[data-add]')!;
      const versionLabel = this.querySelector('[data-version]')!;
      const status = this.querySelector('[role="status"]')!;
      const apply = this.querySelector<HTMLButtonElement>('[data-apply]')!;
      const code = [...this.querySelectorAll<HTMLElement>('[data-code]')];
      const views: { counter: string[]; button: string; step: number }[] = JSON.parse(this.dataset.versions!);
      // The running app's state, which an edit keeps.
      let count = 0;
      let version = 1;

      const render = () => {
        const view = views[version - 1];
        label.textContent = view.counter.join(String(count));
        add.textContent = view.button;
      };

      add.addEventListener('click', () => {
        count += views[version - 1].step;
        render();
      });
      this.querySelector('[data-reset]')!.addEventListener('click', () => {
        count = 0;
        render();
      });

      const announce = (message: string) => {
        const kept = document.createElement('span');
        kept.className = 'kept';
        kept.textContent = `kept: count ${count}`;
        status.replaceChildren(message + ' ', kept);
      };

      apply.addEventListener('click', () => {
        version = version === 1 ? 2 : 1;
        code.forEach((panel) => {
          panel.hidden = Number(panel.dataset.code) !== version;
        });
        render();
        versionLabel.textContent = `version ${version}`;
        apply.textContent = version === 1 ? 'Apply the edit' : 'Undo the edit';
        windowPanel.classList.remove('flash');
        requestAnimationFrame(() => requestAnimationFrame(() => windowPanel.classList.add('flash')));
        announce(`Patched to version ${version}.`);
      });

      this.querySelector('[data-reject]')!.addEventListener('click', () => {
        announce(`Patch rejected. Still running version ${version}.`);
      });
    }
  }

  customElements.define('live-edit-demo', LiveEditDemo);
</script>

<style>
  .demo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--hx-radius-m);
    overflow: hidden;
    background: var(--sl-color-bg-sidebar);
  }
  .demo > * {
    min-width: 0;
  }
  .demo .editor {
    display: flex;
    flex-direction: column;
  }
  .demo .editor .bar {
    justify-content: space-between;
    gap: var(--hx-space-2);
    flex-wrap: wrap;
  }
  .demo :global(.ec-line.del .code) {
    text-decoration: line-through;
  }
  .demo .app {
    padding: var(--hx-space-5);
    display: flex;
    flex-direction: column;
    gap: var(--hx-space-4);
    background: var(--sl-color-accent-low);
  }
  .window {
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    overflow: hidden;
  }
  .window .titlebar {
    display: flex;
    align-items: center;
    gap: var(--hx-space-2);
    padding: var(--hx-space-2) var(--hx-space-3);
    border-bottom: 1px solid var(--sl-color-gray-5);
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--sl-color-gray-5);
  }
  .window .body {
    padding: var(--hx-space-4);
    display: grid;
    gap: var(--hx-space-3);
    justify-items: start;
  }
  .window .body button {
    padding: var(--hx-space-2) var(--hx-space-3);
    border-radius: var(--hx-radius-s);
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-sidebar);
    color: var(--sl-color-white);
    font: inherit;
    cursor: pointer;
  }
  .controls {
    display: flex;
    gap: var(--hx-space-3);
    flex-wrap: wrap;
    align-items: center;
  }
  .status {
    font: 0.8rem var(--sl-font-mono);
    color: var(--sl-color-gray-3);
  }
  .status :global(.kept) {
    display: inline-flex;
    align-items: center;
    gap: var(--hx-space-2);
    background: var(--sl-color-green-low);
    color: var(--sl-color-green-high);
    border-radius: var(--hx-radius-pill);
    padding: 3px 10px;
    font: 600 0.78rem var(--sl-font-mono);
  }
  @media (prefers-reduced-motion: no-preference) {
    .flash {
      animation: flash 900ms ease-out;
    }
    @keyframes flash {
      from {
        box-shadow: 0 0 0 3px var(--sl-color-green-high);
      }
      to {
        box-shadow: 0 0 0 0 transparent;
      }
    }
  }
  .controls .reject {
    padding: var(--hx-space-1);
    border: 0;
    color: var(--sl-color-accent);
    background: none;
    cursor: pointer;
    font: inherit;
    font-size: 0.9rem;
  }
  .demo-note {
    color: var(--sl-color-gray-3);
    font-size: 0.85rem;
  }

  @media (max-width: 55rem) {
    .demo {
      grid-template-columns: 1fr;
    }
  }
</style>
