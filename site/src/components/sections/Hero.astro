---
import CodeCard from '../CodeCard.astro';
import { docsUrl } from '../../../docs.mjs';
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;

const code = `function main() {
	final tasks = ["Buy milk", "Write the report", "Call the plumber"];
	for (task in tasks)
		Sys.println('- $task');
}`;
const output = `- Buy milk
- Write the report
- Call the plumber`;
---

<section class="page-intro">
  <div class="wrap hero">
    <div class="intro">
      <h1 id="_top" tabindex="-1">{title}</h1>
      <p class="lede">{description}</p>
      <div class="ctas">
        <a class="btn primary" href={docsUrl('guides/00-get-started.md')}>Get started</a><a
          class="btn ghost"
          href={docsUrl('guides/02-live-editing.md')}
        >
          See live editing
        </a>
      </div>
      <p class="maturity">Pre-1.0 and changing fast. <a href="/download/">Download or build from source</a></p>
    </div>
    <CodeCard
      lang="haxe"
      title="tasks.hx"
      {code}
      {output}
      command="haxeon tasks.hx"
      example="tasks"
    />
  </div>
</section>

<style>
  .hero {
    --hero-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }
  .maturity {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
