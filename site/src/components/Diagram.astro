---
/* A framed drawing on the dotted paper background; callers place it. */
---

<div class="figure paper"><slot /></div>

<style>
  .figure :global(.drawing) {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
  }
  .figure :global(.drawing text) {
    font-family: var(--sl-font-mono);
    font-size: 13px;
    fill: var(--sl-color-gray-3);
  }
  .figure :global(.drawing .title) {
    fill: var(--sl-color-white);
    font-weight: 600;
  }
  .figure :global(.drawing .line) {
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.4;
    fill: none;
  }
  .figure :global(.drawing .accent) {
    stroke: var(--sl-color-accent);
    stroke-width: var(--hx-stroke-icon);
    fill: none;
  }
  .figure :global(.drawing .accent-fill) {
    fill: var(--sl-color-accent);
  }
  .figure :global(.drawing .box) {
    fill: var(--sl-color-bg-sidebar);
    stroke: var(--sl-color-gray-3);
    stroke-width: 1.4;
  }
  .figure :global(.drawing .codebox) {
    fill: var(--hx-code-bg);
    stroke: none;
  }
  .figure :global(.drawing .code-text) {
    fill: var(--hx-code-fg);
  }
  .figure {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--hx-radius-m);
    padding: var(--hx-space-5);
    overflow-x: auto;
  }
</style>
