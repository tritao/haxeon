# Cloudflare Pages headers. Astro's build output in /_astro/ is named by content hash, so it never changes under a name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The live embeds keep their names across builds: cache them briefly, and keep their standalone pages out of search.
/gpu/circuit-run/*
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex
/ui/showcase/*
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex
