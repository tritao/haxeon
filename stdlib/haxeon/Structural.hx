package haxeon;

/**
 * Operations over every stored field of a value class or a class marked `@:structural`, generated by the compiler from the
 * class declaration at each call site: `copy`, `hash`, `changedMask`, `assignChanged`, `fieldBit` and `allFieldsMask`.
 * Because they come from the declaration, adding a field updates them all; a field type they cannot handle is an error.
 * Equality is `haxeon.Equality.equals`, which accepts the same classes. The functions below are what the generated hashes
 * call.
 */
class Structural {
	/** Folds one field's hash into a running hash. */
	public static inline function mix(hash:Int, value:Int):Int
		return hash * 31 + value;

	/** Hash of a Float consistent with `==`, which treats 0.0 and -0.0 as equal and NaN as unequal to itself. */
	public static function hashFloat(value:Float):Int {
		if (value != value)
			return 0x7fc00000;
		if (value == 0.0)
			return 0;
		var whole = value >= 2147483647.0 ? 2147483647 : value <= -2147483647.0 ? -2147483647 : Std.int(value);
		return whole * 31 + Std.int((value - whole) * 16777216.0);
	}

	public static function hashString(value:Null<String>):Int {
		if (value == null)
			return 0;
		var hash = value.length;
		for (index in 0...value.length)
			hash = hash * 31 + StringTools.fastCodeAt(value, index);
		return hash;
	}
}
