{
  "name": "haxeon-vscode",
  "displayName": "Haxeon",
  "version": "0.1.0",
  "publisher": "haxeon",
  "engines": {"vscode": "^1.90.0"},
  "categories": ["Programming Languages", "Visualization", "Debuggers"],
  "activationEvents": ["onLanguage:haxe", "onCommand:haxeon.profiler.open",
    "onDebugInitialConfigurations", "onDebugResolve:haxeon", "onDebugDynamicConfigurations:haxeon"],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -p ./ && node scripts/build-adapter.cjs",
    "vscode:prepublish": "npm run build",
    "check": "tsc -p ./ --noEmit"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-debugadapter": "1.51.0",
    "vscode-debugprotocol": "1.51.0"
  },
  "devDependencies": {"@types/node": "^22.10.0", "@types/vscode": "^1.90.0", "typescript": "^5.7.2"},
  "contributes": {
    "breakpoints": [{"language": "haxe"}],
    "debuggers": [
      {
        "type": "haxeon",
        "label": "Haxeon",
        "languages": ["haxe"],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "cwd": {"type": "string", "description": "Project directory.", "default": "${workspaceFolder}"},
              "args": {"type": "array", "items": {"type": "string"}, "default": [], "description": "Arguments passed to the app."}
            }
          },
          "attach": {
            "properties": {
              "cwd": {"type": "string", "description": "Project directory.", "default": "${workspaceFolder}"},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535, "default": 6112, "description": "Local HashLink debug port."},
              "program": {"type": "string", "default": "build/host/main.hl", "description": "Bytecode for the running program, relative to cwd or absolute."},
              "sourceRoots": {"type": "array", "items": {"type": "string"}, "default": ["src"], "description": "Source roots for the running program, relative to cwd or absolute."}
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Haxeon: Launch",
            "body": {"type": "haxeon", "request": "launch", "name": "Launch Haxeon"}
          },
          {
            "label": "Haxeon: Attach",
            "body": {"type": "haxeon", "request": "attach", "name": "Attach to Haxeon", "port": 6112}
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "haxe",
        "aliases": ["Haxe", "haxe"],
        "extensions": [".hx"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "hxi",
        "aliases": ["Haxeon Interface", "hxi"],
        "extensions": [".hxi"]
      }
    ],
    "grammars": [
      {
        "language": "haxe",
        "scopeName": "source.haxeon.hx",
        "path": "./syntaxes/haxe.tmLanguage.json"
      },
      {
        "language": "hxi",
        "scopeName": "source.haxeon.hxi",
        "path": "./syntaxes/hxi.tmLanguage.json"
      }
    ],
    "commands": [
      {"command": "haxeon.profiler.open", "title": "Haxeon: Open Realtime Profiler"},
      {"command": "haxeon.profiler.setToken", "title": "Haxeon: Set Diagnostics Token"},
      {"command": "haxeon.profiler.clearToken", "title": "Haxeon: Clear Diagnostics Token"}
    ],
    "configuration": {
      "title": "Haxeon",
      "properties": {
        "haxeon.server.path": {"type": "string", "default": "haxeon", "description": "The haxeon command, which runs the language server."},
        "haxeon.server.args": {"type": "array", "items": {"type": "string"}, "default": ["lsp"], "description": "Arguments that start the language server."},
        "haxeon.profiler.host": {"type": "string", "default": "127.0.0.1"},
        "haxeon.profiler.port": {"type": "number", "default": 6113, "minimum": 1, "maximum": 65535},
        "haxeon.profiler.sampleRate": {"type": "number", "default": 250, "minimum": 1, "maximum": 100000}
        ,"haxeon.profiler.hlprofPath": {"type": "string", "default": "hlprof-live", "description": "Path to the native capture/report tool."}
      }
    }
  }
}
