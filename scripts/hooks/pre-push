#!/usr/bin/env bash
# Refuses a push whose commits leave a Haxe file unformatted, with unused imports or with its imports out of order, which
# CI's format check would fail, or that change the compiler's sources (src/, lib/haxeon-io/, stdlib/) so that the compiler no
# longer compiles them (tests/integration/test-self-build.sh, about a minute with the tool compiler rebuilt). A push that deletes
# or renames a file under src/ also type-checks every module and every tests/compiler main with stock Haxe
# (tests/integration/test-type-check-all.sh, about twenty seconds): a main that imports what was removed fails there, and
# otherwise only in the test driver. Enable it in a checkout with `git config core.hooksPath scripts/hooks`;
# `git push --no-verify` skips it, SKIP_SELF_BUILD=1 only the self-build check.
#
# It checks the files the pushed commits change, as they are in this working tree: run it from the tree you push. A push that
# changes no Haxe file is not checked, nor one from a tree without a native build (a scratch worktree), which CI still checks.
# A push that moves the NativeKit pin or changes a package's bindings or their generators also checks that every package's
# generated bindings match the NativeKit headers, which CI's binding and package jobs would fail.
set -eu
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
self_build=0
type_check=0
bindings=0
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue
	if [ "$remote_sha" = "$zero" ]; then
		base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || continue
	else
		base=$remote_sha
	fi
	[ -n "$(git diff --name-only -M --diff-filter=DR "$base..$local_sha" -- src)" ] && type_check=1
	[ -n "$(git diff --name-only "$base..$local_sha" -- vendor/nativekit 'packages/*/bindings' 'packages/*/tools/update-haxeon-*' \
		'packages/*/native/tools/update-haxeon-*' 'packages/*/tools/audit-haxeon-abi.sh')" ] && bindings=1
	[ -n "$(git diff --name-only --diff-filter=d "$base..$local_sha" -- '*.hx')" ] || continue
	if [ ! -f "$("$root/scripts/hashlink-path.sh" --build-dir)/CMakeCache.txt" ]; then
		echo "pre-push: no native build in this tree, so the pushed Haxe files are not checked" >&2
		continue
	fi
	"$root/scripts/haxeon" dev format --check --range "$base..$local_sha" || status=1
	[ -n "$(git diff --name-only "$base..$local_sha" -- src lib/haxeon-io stdlib)" ] && self_build=1
done
if [ "$status" -ne 0 ]; then
	echo "pre-push: fix with scripts/haxeon dev format --changed (or haxeon fmt / haxeon lint --fix FILES)" >&2
fi
if [ "$bindings" = 1 ]; then
	for check in "$root"/packages/*/tools/update-haxeon-*hxi.sh "$root"/packages/*/native/tools/update-haxeon-*hxi.sh; do
		"$check" --check >/dev/null || status=1
	done
fi
if [ "$type_check" = 1 ]; then
	bash "$root/tests/integration/test-type-check-all.sh" || status=1
fi
if [ "$self_build" = 1 ] && [ "${SKIP_SELF_BUILD:-}" != 1 ]; then
	bash "$root/tests/integration/test-self-build.sh" || status=1
fi
exit "$status"
