#!/usr/bin/env bash
set -euo pipefail

root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
haxe="$root_dir/.tools/haxe/haxe"

if [[ ! -x "$haxe" ]]; then
	echo "missing pinned Haxe compiler; run scripts/bootstrap-tools.sh first" >&2
	exit 1
fi

export HAXEON_HOME="$root_dir"
hashlink_dir=$("$root_dir/scripts/hashlink-path.sh")
hashlink="$hashlink_dir/hl"
export HAXEON_HASHLINK_DIR="$hashlink_dir"
if [[ ! -x "$hashlink" ]]; then
	echo "Missing checkout-built HashLink: $hashlink; run scripts/build-native.sh first" >&2
	exit 1
fi
cli="$root_dir/out/haxeon-cli.hl"
mkdir -p "$root_dir/out"
# A checkout can give unchanged sources new mtimes. Hash the inputs instead so a
# pin bump only rebuilds the CLI when its content changes. Include the pinned
# host compiler and its standard library; additions and removals also invalidate.
if command -v sha256sum >/dev/null 2>&1; then
	checksum=(sha256sum)
else
	checksum=(shasum -a 256)
fi
fingerprint=$(
	cd "$root_dir"
	{
		find src .tools/haxe/std -type f -exec "${checksum[@]}" {} +
		"${checksum[@]}" scripts/haxeon .tools/haxe/haxe
	} | LC_ALL=C sort | "${checksum[@]}"
)
stamp="$cli.inputs"
if [[ ! -f "$cli" || ! -f "$stamp" || "$(cat "$stamp")" != "$fingerprint" ]]; then
	temporary="$cli.tmp.$$"
	trap 'rm -f "$temporary" "$temporary.inputs"' EXIT
	"$haxe" -cp "$root_dir/src" -cp "$root_dir/lib/haxeon-io" -main tools.HaxeonCli -hl "$temporary"
	printf '%s\n' "$fingerprint" > "$temporary.inputs"
	mv "$temporary" "$cli"
	mv "$temporary.inputs" "$stamp"
	trap - EXIT
fi
export LD_LIBRARY_PATH="$hashlink_dir:$root_dir/out${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$hashlink" "$cli" "$@"
