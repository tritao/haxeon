#!/usr/bin/env bash
# This checkout's haxeon command: the VM running the Haxeon CLI (native/haxeon_main.c), built by the native build with the
# CLI's bytecode beside it. The two are brought up to date first, so an edit to the CLI's sources is in the next command;
# HAXEON_NATIVE_READY=1 says a caller already did that (the suite runner, once: concurrent builds of one tree race).
set -euo pipefail

root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
hashlink_dir=$("$root_dir/scripts/hashlink-path.sh")
build_dir=$("$root_dir/scripts/hashlink-path.sh" --build-dir)

if [[ ${HAXEON_NATIVE_READY:-0} != 1 ]]; then
	if [[ ! -f $build_dir/CMakeCache.txt ]]; then
		echo "No native build in $build_dir; run scripts/bootstrap-tools.sh and scripts/build-native.sh first" >&2
		exit 1
	fi
	# Diagnostics go to stderr only on failure: callers capture stdout (`$(scripts/haxeon dev tool-path ...)`).
	if ! log=$(cmake --build "$build_dir" --target haxeon-command 2>&1); then
		printf '%s\n' "$log" >&2
		exit 1
	fi
fi
haxeon="$hashlink_dir/haxeon"
[[ -e $haxeon || ! -e $haxeon.exe ]] || haxeon=$haxeon.exe
# Test libraries that the programs the CLI runs load by name.
export LD_LIBRARY_PATH="$root_dir/out${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export DYLD_LIBRARY_PATH="$root_dir/out${DYLD_LIBRARY_PATH:+:$DYLD_LIBRARY_PATH}"
exec "$haxeon" "$@"
