#!/usr/bin/env bash
set -euo pipefail
root_dir=$(cd "$(dirname "$0")/.." && pwd)
haxe_bin=${NATIVEKIT_HAXE_BIN:-"$root_dir/.tools/haxe/haxe"}
# The class paths common.hxml lists, as absolute paths: callers pass paths relative to their own directory, so no --cwd.
mapfile -t class_paths < <("$root_dir/scripts/compiler-class-paths.sh" --cp-args)
exec "$haxe_bin" "${class_paths[@]}" --run FfiAuditMain "$@"
