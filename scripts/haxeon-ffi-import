#!/usr/bin/env bash
# The C and C++ header importer, `haxeon ffi import`; this name stays for the scripts that use it. It runs in the checkout's
# root, as it always has, so relative paths are relative to it.
set -euo pipefail
root_dir=$(cd "$(dirname "$0")/.." && pwd)
cd "$root_dir"
exec "$root_dir/scripts/haxeon" ffi import "$@"
