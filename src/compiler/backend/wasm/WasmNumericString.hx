			Call(umul),
			LocalSet(5),
			Drop,
			LocalGet(5),
			LocalGet(3),
			I64Add,
			LocalSet(6),
			LocalGet(6),
			LocalGet(5),
			I64LtU,
			LocalSet(7),
			LocalGet(4),
			LocalGet(7),
			I64ExtendI32U,
			I64Add,
			LocalSet(4),
