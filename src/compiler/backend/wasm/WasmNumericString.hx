		];
		return module.addFunction(new WasmFunction(name, {parameters: [I64, I32, I32], results: [I64]},
			[{type: I64}, {type: I64}, {type: I64}, {type: I64}, {type: I32}, {type: I32}], body));
	}

	static function addMultiplyShiftAll(module:WasmModule, name:String, mulShift:Int):Int {
