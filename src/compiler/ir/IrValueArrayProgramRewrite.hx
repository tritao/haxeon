package compiler.ir;

import compiler.ir.Ir;
import compiler.ir.IrValueLaneLayout.IrValueLaneTarget;
import compiler.ir.SourceProvenance.Located;

/** Index immutable function bodies once, including helpers generated by preceding shapes. */
private class ValueArrayFunctionIndex {
	var types:Map<String, {source:IrFunction, elements:Map<String, Bool>, dynamicViews:Bool}> = [];
	var dynamicDone:Map<String, IrFunction> = [];
	var originals:Map<String, IrFunction> = [];

	public function originalFunctions(functions:Array<IrFunction>):Map<String, IrFunction> {
		for (fn in functions)
			if (originals.get(fn.name) != fn)
				originals.set(fn.name, fn);
		return originals;
	}

	final objectKeys:Map<String, String> = [];
	final optionalKeys:Map<String, String> = [];
	final enumKeys:Map<String, String> = [];
	final tagKeys:Map<String, String> = [];

	public function new(elements:Array<IrType>) {
		for (element in elements)
			switch element {
				case Obj(name):
					objectKeys.set(name, "value:" + name);
				case Nullable(Obj(name)):
					optionalKeys.set(name, "nullable:" + name);
				case Enum(name):
					enumKeys.set(name, "enum:" + name);
				case EnumTag(name):
					tagKeys.set(name, "enum-tag:" + name);
				default:
			}
	}

	function key(type:IrType):Null<String>
		return switch type {
			case Obj(name): objectKeys.get(name);
			case Nullable(Obj(name)): optionalKeys.get(name);
			case Enum(name): enumKeys.get(name);
			case EnumTag(name): tagKeys.get(name);
			default: null;
		};

	function summary(fn:IrFunction):{source:IrFunction, elements:Map<String, Bool>, dynamicViews:Bool} {
		var known = types.get(fn.name);
		if (known != null && known.source == fn)
			return known;
		var elements:Map<String, Bool> = [], dynamicViews = false;
		function visit(type:IrType):Void
			switch type {
				case Array(element), Iterator(element):
					var name = key(element);
					if (name != null)
						elements.set(name, true);
					visit(element);
				case Nullable(element):
					visit(element);
				case Function(arguments, result):
					for (argument in arguments)
						visit(argument);
					visit(result);
				default:
			}
		for (argument in fn.arguments)
			visit(argument.type);
		visit(fn.result);
		for (block in fn.blocks)
			for (located in block.instructions) {
				var output = IrOperands.output(located.value);
				if (output != null)
					visit(output.type);
				// Valid SSA uses share their definition's type. Discover each carrier once.
				if (IrValueArrayProgramRewrite.dynamicViewKind(located.value) != 0)
					dynamicViews = true;
				switch located.value {
					case TypeValue(_, type):
						visit(type);
					default:
				}
			}
		known = {source: fn, elements: elements, dynamicViews: dynamicViews};
		types.set(fn.name, known);
		return known;
	}

	public function has(fn:IrFunction, element:IrType):Bool {
		var name = key(element);
		return name != null && summary(fn).elements.exists(name);
	}

	public function needsDynamic(fn:IrFunction):Bool
		return dynamicDone.get(fn.name) != fn && summary(fn).dynamicViews;

	public function finish(fn:IrFunction):Void
		dynamicDone.set(fn.name, fn);
}

/** Assemble the per-shape lowering after mutable places have been marked by the frontend. */
class IrValueArrayProgramRewrite {
	/** Discover every concrete value array in the assembled program before generating any helpers. */
	public static function rewriteAll(program:IrProgram, pointerBits:Int, target:IrValueLaneTarget):Void {
		var values:Map<String, Bool> = [for (object in program.objects) if (object.isValue) object.name => true],
			inlineEnums:Map<String, Bool> = [for (entry in program.enums) if (entry.inlineStorage != null) entry.name => true],
			elements:Map<String, IrType> = [];
		var seenTags:Map<String, Bool> = [],
			seenEnums:Map<String, Bool> = [],
			seenValues:Map<String, Bool> = [],
			seenOptionalValues:Map<String, Bool> = [];
		function register(element:IrType, seen:Map<String, Bool>, name:String):Void {
			if (seen.exists(name))
				return;
			seen.set(name, true);
			elements.set(haxe.crypto.Base64.encode(compiler.ir.codec.IrTypeCodec.encode(element)), element);
		}
		function visit(type:IrType):Void
			switch type {
				case Array(element):
					switch element {
						case EnumTag(name): register(element, seenTags, name);
						case Enum(name) if (inlineEnums.exists(name)): register(element, seenEnums, name);
						case Obj(name) if (values.exists(name)): register(element, seenValues, name);
						case Nullable(Obj(name)) if (values.exists(name)): register(element, seenOptionalValues, name);
						default:
					}
					visit(element);
				case Nullable(element), Iterator(element):
					visit(element);
				case Function(arguments, result):
					for (argument in arguments)
						visit(argument);
					visit(result);
				default:
			}
		for (object in program.objects)
			for (field in object.fields)
				visit(field.type);
		for (item in program.enums)
			for (constructor in item.cases)
				for (argument in constructor.params)
					visit(argument);
		for (item in program.interfaces)
			for (method in item.methods) {
				for (argument in method.arguments)
					visit(argument);
				visit(method.result);
			}
		for (field in program.staticFields)
			visit(field.type);
		for (native in program.natives) {
			for (argument in native.arguments)
				visit(argument);
			visit(native.result);
		}
		for (fn in program.functions) {
			for (argument in fn.arguments)
				visit(argument.type);
			visit(fn.result);
			for (block in fn.blocks)
				for (located in block.instructions) {
					var output = IrOperands.output(located.value);
					if (output != null)
						visit(output.type);
					// SSA arguments and definitions cover every operand type, including phi edge uses.
					switch located.value {
						case TypeValue(_, type):
							visit(type);
						default:
					}
				}
		}
		var keys = [for (key in elements.keys()) key];
		keys.sort(Reflect.compare);
		var index = new ValueArrayFunctionIndex([for (key in keys) elements.get(key)]),
			slotNamespace = nextSlotNamespace(program);
		for (key in keys)
			rewriteIndexed(program, elements.get(key), pointerBits, target, index, slotNamespace++);
		IrArrayFactory.lower(program);
		IrVerifier.verifyValueArraysLowered(program);
	}

	public static function rewrite(program:IrProgram, element:IrType, pointerBits:Int, target:IrValueLaneTarget):Void {
		rewriteIndexed(program, element, pointerBits, target, new ValueArrayFunctionIndex([element]), nextSlotNamespace(program));
	}

	static function nextSlotNamespace(program:IrProgram):Int {
		var next = 0;
		for (fn in program.functions)
			switch fn.kind {
				case ValueArraySlot(namespace, _, _):
					if (namespace >= next)
						next = namespace + 1;
				default:
			}
		return next;
	}

	static function rewriteIndexed(program:IrProgram, element:IrType, pointerBits:Int, target:IrValueLaneTarget, index:ValueArrayFunctionIndex,
			slotNamespace:Int):Void {
		switch element {
			case EnumTag(name):
				IrEnumTagStorage.request(program, name);
			default:
		}
		var declarations:Map<String, IrObject> = [for (object in program.objects) object.name => object],
			tagUnboxes:Map<String, IrType> = [],
			objects = IrObjectTable.of(declarations),
			factory = new IrValueArrayFactory(objects, element, pointerBits, target, slotNamespace, program.enums),
			elements = new IrValueArrayElements(element, factory.helpers, factory.bridge),
			methods = new IrValueArrayPlaceMethods(objects, element, factory.helpers),
			originals = index.originalFunctions(program.functions),
			rewritten:Null<Array<IrFunction>> = null;
		switch element {
			case EnumTag(_):
				for (fn in program.functions)
					switch fn.kind {
						case EnumTagAdapter(type, false): tagUnboxes.set(fn.name, type);
						default:
					}
			default:
		}
		var optional:Null<IrValueArrayOptionalComponents> = switch element {
			case Nullable(Obj(name)) if (declarations.exists(IrOptionalScalarFlow.wrapperName(name))):
				new IrValueArrayOptionalComponents(objects, element, factory.helpers);
			default: null;
		};
		for (functionIndex in 0...program.functions.length) {
			var fn = program.functions[functionIndex], selected = index.has(fn, element), current = fn;
			if (selected) {
				current = IrValueArrayRangeRewrite.rewrite(current, element, factory);
				var roots = IrValueArrayPlaceRewrite.roots(current, element);
				if (roots.keys().hasNext())
					current = IrValueArrayPlaceRewrite.rewrite(current, element, objects, factory.helpers, methods, roots);
				if (optional != null)
					current = IrValueArrayOptionalRewrite.rewrite(current, element, optional);
				current = IrValueArrayElementRewrite.rewrite(current, element, elements, tagUnboxes);
			}
			if (selected || index.needsDynamic(fn))
				current = rewriteDynamicViews(current);
			if (selected) {
				current = rewriteAllocations(current, element, factory.allocateName());
				current = rewriteCasts(current, element, factory.retypeName());
			}
			index.finish(current);
			if (rewritten != null)
				rewritten.push(current);
			else if (current != fn) {
				rewritten = program.functions.slice(0, functionIndex);
				rewritten.push(current);
			}
		}
		var generatedMethods = methods.generate(originals),
			generatedFactories = factory.functions(),
			generatedElements = elements.functions(),
			generatedOptional = optional == null ? [] : optional.functions(),
			generatedSlots = factory.helpers.functions();
		if (rewritten != null)
			program.functions = rewritten;
		var generatedStart = program.functions.length,
			generatedFunctions:Array<IrFunction> = [];
		for (generated in [
			generatedMethods,
			generatedFactories,
			generatedElements,
			generatedOptional,
			generatedSlots
		])
			for (fn in generated) {
				program.functions.push(fn);
				generatedFunctions.push(fn);
			}
		// Resolve only these late producers. Place methods can clone an existing body containing typed requests.
		IrEnumTagLowering.resolveGenerated(program, generatedFunctions);
		IrVerifier.verifyResolvedEnumOperations(program.functions.slice(generatedStart));
		var nullableScalars = false;
		for (slot in factory.layout.lanes.slots)
			if (slot.nullablePayload)
				nullableScalars = true;
		IrValueArrayScalarLowering.rewrite(program, element, target != HashLink || nullableScalars);
		var nativeNames:Map<String, Bool> = [for (native in program.natives) native.name => true];
		for (native in factory.natives().concat(factory.helpers.natives()).concat(elements.natives()))
			if (!nativeNames.exists(native.name)) {
				nativeNames.set(native.name, true);
				program.natives.push(native);
			}
		// Dynamic views can be introduced after initial assembly; their Wasm dispatch also needs all concrete storage operations.
		IrProgramAssembler.ensureArrayRuntime(program, false, false, false);
		for (native in program.natives)
			nativeNames.set(native.name, true);
		var dynamicNatives:Array<IrNative> = [
			{
				name: "__array_get_any",
				library: "haxeon_runtime",
				symbol: "__array_get_any",
				arguments: [Array(Dyn), I32],
				result: Dyn
			},
			{
				name: "__array_set_any",
				library: "haxeon_runtime",
				symbol: "__array_set_any",
				arguments: [Array(Dyn), I32, Dyn],
				result: Void
			},
			{
				name: "__array_push_any",
				library: "haxeon_runtime",
				symbol: "__array_push_any",
				arguments: [Array(Dyn), Dyn],
				result: I32
			},
			{
				name: "__array_unshift_any",
				library: "haxeon_runtime",
				symbol: "__array_unshift_any",
				arguments: [Array(Dyn), Dyn],
				result: I32
			},
			{
				name: "__array_insert_any",
				library: "haxeon_runtime",
				symbol: "__array_insert_any",
				arguments: [Array(Dyn), I32, Dyn],
				result: Void
			},
			{
				name: "__array_reverse_any",
				library: "haxeon_runtime",
				symbol: "__array_reverse_any",
				arguments: [Array(Dyn)],
				result: Void
			},
			{
				name: "__array_resize_any",
				library: "haxeon_runtime",
				symbol: "__array_resize_any",
				arguments: [Array(Dyn), I32],
				result: Void
			},
			{
				name: "__array_copy_any",
				library: "haxeon_runtime",
				symbol: "__array_copy_any",
				arguments: [Array(Dyn)],
				result: Array(Dyn)
			},
			{
				name: "__array_slice_any",
				library: "haxeon_runtime",
				symbol: "__array_slice_any",
				arguments: [Array(Dyn), I32, I32],
				result: Array(Dyn)
			},
			{
				name: "__array_splice_any",
				library: "haxeon_runtime",
				symbol: "__array_splice_any",
				arguments: [Array(Dyn), I32, I32],
				result: Array(Dyn)
			},
			{
				name: "__array_concat_any",
				library: "haxeon_runtime",
				symbol: "__array_concat_any",
				arguments: [Array(Dyn), Array(Dyn)],
				result: Array(Dyn)
			},
			{
				name: "__array_pop_any",
				library: "haxeon_runtime",
				symbol: "__array_pop_any",
				arguments: [Array(Dyn)],
				result: Dyn
			},
			{
				name: "__array_shift_any",
				library: "haxeon_runtime",
				symbol: "__array_shift_any",
				arguments: [Array(Dyn)],
				result: Dyn
			},
			{
				name: "__array_remove_at_any",
				library: "haxeon_runtime",
				symbol: "__array_remove_at_any",
				arguments: [Array(Dyn), I32],
				result: Void
			}
		];
		for (native in dynamicNatives)
			if (!nativeNames.exists(native.name)) {
				nativeNames.set(native.name, true);
				program.natives.push(native);
			}
	}

	/** A checked concrete view must install the lane representation on the shared dynamic header. */
	static function rewriteCasts(fn:IrFunction, element:IrType, retype:String):IrFunction {
		var next = 0, changed = false, blocks:Array<IrBlock> = [];
		for (argument in fn.arguments)
			if (argument.id >= next)
				next = argument.id + 1;
		for (block in fn.blocks)
			for (located in block.instructions) {
				var output = IrOperands.output(located.value);
				if (output != null && output.id >= next)
					next = output.id + 1;
				for (input in IrOperands.inputs(located.value))
					if (input.id >= next)
						next = input.id + 1;
			}
		for (block in fn.blocks) {
			var target = new IrBlock(block.id);
			for (located in block.instructions)
				switch located.value {
					case SafeCast(out, input) if (Type.enumEq(out.type, Array(element)) && (switch (input.type) {
						case Dyn: true;
						default: false;
					})):
						var dynamicView = new IrValue(next++, "$value-array-dynamic-view", Array(Dyn));
						target.instructions.push(new Located(SafeCast(dynamicView, input), located.provenance));
						target.instructions.push(new Located(Call(out, retype, [dynamicView]), located.provenance));
						changed = true;
					default:
						target.instructions.push(located);
				}
			target.terminator = block.terminator;
			blocks.push(target);
		}
		return changed ? fn.withBlocks(blocks) : fn;
	}

	/** A shared classifier keeps the immutable index and actual rewrite in agreement. */
	public static function dynamicViewKind(instruction:IrInstruction):Int {
		return switch instruction {
			case ArrayGet(out, array, _) if ((switch array.type {
				case Array(Dyn): true;
				default: false;
			}) && (switch out.type {
				case Dyn: true;
				default: false;
			})): 1;
			case ArraySet(array, _, value) if ((switch array.type {
				case Array(Dyn): true;
				default: false;
			}) && (switch value.type {
				case Dyn: true;
				default: false;
			})): 2;
			case Call(_, name, args) if (args.length > 0 && (switch args[0].type {
				case Array(Dyn): true;
				default: false;
			}) && (name == "__array_push_ref" || name == "__array_unshift_ref" || name == "__array_insert_ref" || name == "__array_reverse_ref"
				|| name == "__array_resize_ref" || name == "__array_copy_ref" || name == "__array_slice_ref" || name == "__array_splice_ref"
				|| name == "__array_concat_ref" || name == "__array_pop_ref" || name == "__array_shift_ref" || name == "__array_index_of_ref"
				|| name == "__array_remove_ref")): 3;
			default: 0;
		};
	}

	/** Dynamic views dispatch by runtime storage; bodies and blocks are copied only on an actual change. */
	static function rewriteDynamicViews(fn:IrFunction):IrFunction {
		var next = -1, blocks:Null<Array<IrBlock>> = null;
		for (blockIndex in 0...fn.blocks.length) {
			var block = fn.blocks[blockIndex], target:Null<IrBlock> = null;
			for (position in 0...block.instructions.length) {
				var located = block.instructions[position],
					kind = dynamicViewKind(located.value);
				if (kind == 0) {
					if (target != null)
						target.instructions.push(located);
					continue;
				}
				if (target == null) {
					target = new IrBlock(block.id);
					for (previous in 0...position)
						target.instructions.push(block.instructions[previous]);
					target.terminator = block.terminator;
				}
				var instruction = switch located.value {
					case ArrayGet(out, array, index): Call(out, "__array_get_any", [array, index]);
					case ArraySet(array, index, value):
						if (next < 0) {
							next = 0;
							for (argument in fn.arguments)
								if (argument.id >= next)
									next = argument.id + 1;
							for (body in fn.blocks)
								for (entry in body.instructions) {
									var output = IrOperands.output(entry.value);
									if (output != null && output.id >= next)
										next = output.id + 1;
								}
						}
						Call(new IrValue(next++, "$dynamic-array-write", Void), "__array_set_any", [array, index, value]);
					case Call(out, name, args): Call(out, name.substr(0, name.length - 3) + "any", args);
					default: throw "Dynamic array classifier disagrees with its rewrite";
				};
				target.instructions.push(new Located(instruction, located.provenance));
			}
			if (target != null) {
				if (blocks == null)
					blocks = fn.blocks.slice(0, blockIndex);
				blocks.push(target);
			} else if (blocks != null)
				blocks.push(block);
		}
		return blocks == null ? fn : fn.withBlocks(blocks);
	}

	static function rewriteAllocations(fn:IrFunction, element:IrType, allocator:String):IrFunction {
		var arrayType:IrType = Array(element),
			changed = false,
			blocks:Array<IrBlock> = [];
		for (block in fn.blocks) {
			var target = new IrBlock(block.id);
			for (located in block.instructions) {
				var instruction = switch located.value {
					case Call(out, name, arguments)
						if ((name == IrArrayFactory.NAME || name == "__array_alloc_ref") && IrVerifier.sameType(out.type, arrayType)):
						if (arguments.length != 1)
							throw "Invalid array factory arguments";
						changed = true;
						Call(out, allocator, arguments);
					default: located.value;
				};
				target.instructions.push(new Located(instruction, located.provenance));
			}
			target.terminator = block.terminator;
			blocks.push(target);
		}
		return changed ? fn.withBlocks(blocks) : fn;
	}
}
