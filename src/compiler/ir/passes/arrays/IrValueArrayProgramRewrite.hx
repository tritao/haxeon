package compiler.ir.passes.arrays;

import compiler.core.InternalError;
import compiler.ir.model.Ir;
import compiler.ir.model.IrBody;
import compiler.ir.model.IrBodyBuilder;
import compiler.ir.model.IrFunction;
import compiler.ir.model.IrObjectTable;
import compiler.ir.model.IrOpcode;
import compiler.ir.model.IrPassScratch;
import compiler.ir.model.IrSymbol;
import compiler.ir.model.IrTypeIdentity;
import compiler.ir.model.IrTypeIds;
import compiler.ir.passes.enums.IrEnumTagLowering;
import compiler.ir.passes.enums.IrEnumTagStorage;
import compiler.ir.passes.nullability.IrOptionalScalarFlow;
import compiler.ir.passes.values.IrValueLaneLayout.IrValueLaneTarget;
import compiler.ir.pipeline.IrProgramAssembler;
import compiler.ir.verify.IrVerifier;

/** What a function's body says about value arrays: the element keys its types name, and whether it has dynamic views. */
private typedef ValueArraySummary = {
	final source:IrFunction;
	final elements:Map<String, Bool>;
	final dynamicViews:Bool;
}

/** Index function bodies once, including helpers generated by preceding shapes; a summary holds while its function is the same. */
@:nullSafety(Strict)
private class ValueArrayFunctionIndex {
	/** The keys of a type that names none, shared by every such type. */
	final none:Array<String> = [];

	final builder:IrBodyBuilder;
	var summaries:Map<String, ValueArraySummary> = [];
	var dynamicDone:Map<String, IrFunction> = [];
	var originals:Map<String, IrFunction> = [];

	/** By type id, the element keys a type names, once computed. */
	final typeKeys:Array<Null<Array<String>>> = [];

	final objectKeys:Map<String, String> = [];
	final optionalKeys:Map<String, String> = [];
	final enumKeys:Map<String, String> = [];
	final tagKeys:Map<String, String> = [];

	public function new(elements:Array<IrType>, builder:IrBodyBuilder) {
		this.builder = builder;
		for (element in elements)
			switch element {
				case Obj(name):
					objectKeys.set(name, "value:" + name);
				case Nullable(Obj(name)):
					optionalKeys.set(name, "nullable:" + name);
				case Enum(name):
					enumKeys.set(name, "enum:" + name);
				case EnumTag(name):
					tagKeys.set(name, "enum-tag:" + name);
				default:
			}
	}

	/** `fn`'s body: the one it is, or its encoding, kept. */
	public inline function bodyOf(fn:IrFunction):IrBody
		return fn.encodedBody(builder);

	public function originalFunctions(functions:Array<IrFunction>):Map<String, IrFunction> {
		for (fn in functions)
			if (originals.get(fn.name) != fn)
				originals.set(fn.name, fn);
		return originals;
	}

	function key(type:IrType):Null<String>
		return switch type {
			case Obj(name): objectKeys.get(name);
			case Nullable(Obj(name)): optionalKeys.get(name);
			case Enum(name): enumKeys.get(name);
			case EnumTag(name): tagKeys.get(name);
			default: null;
		};

	/** The element keys of the arrays and iterators type `id` names, at any depth. */
	function keysOf(id:Int):Array<String> {
		var known = id < typeKeys.length ? typeKeys[id] : null;
		if (known != null)
			return known;
		var found:Null<Array<String>> = null;
		function visit(type:IrType):Void
			switch type {
				case Array(element), Iterator(element):
					var name = key(element);
					if (name != null) {
						var names = found;
						if (names == null)
							found = names = [];
						names.push(name);
					}
					visit(element);
				case Nullable(element):
					visit(element);
				case Function(arguments, result):
					for (argument in arguments)
						visit(argument);
					visit(result);
				default:
			}
		visit(IrTypeIds.type(id));
		var result = found == null ? none : found;
		while (typeKeys.length <= id)
			typeKeys.push(null);
		typeKeys[id] = result;
		return result;
	}

	function summary(fn:IrFunction):ValueArraySummary {
		var known = summaries.get(fn.name);
		if (known != null && known.source == fn)
			return known;
		var body = bodyOf(fn), elements:Map<String, Bool> = [], dynamicViews = false;
		var arrayDyn = body.typeId(Array(Dyn)), dyn = body.typeId(Dyn);
		inline function visit(id:Int):Void
			for (name in keysOf(id))
				elements.set(name, true);
		for (index in 0...body.argumentCount())
			visit(body.valueTypeId(body.argument(index)));
		visit(body.result);
		for (block in 0...body.blockCount()) {
			var row = body.firstRow(block);
			while (row >= 0) {
				var output = body.output(row);
				if (output.exists())
					visit(body.valueTypeId(output));
				// Valid SSA uses share their definition's type. Discover each carrier once.
				if (IrValueArrayProgramRewrite.dynamicViewKind(body, row, arrayDyn, dyn) != 0)
					dynamicViews = true;
				if (body.opcode(row) == IrOpcode.TypeValue)
					visit(body.aux(row));
				row = body.nextRow(row);
			}
		}
		known = {source: fn, elements: elements, dynamicViews: dynamicViews};
		summaries.set(fn.name, known);
		return known;
	}

	public function has(fn:IrFunction, element:IrType):Bool {
		var name = key(element);
		return name != null && summary(fn).elements.exists(name);
	}

	public function needsDynamic(fn:IrFunction):Bool
		return dynamicDone.get(fn.name) != fn && summary(fn).dynamicViews;

	public function finish(fn:IrFunction):Void
		dynamicDone.set(fn.name, fn);
}

/**
 * Assemble the per-shape lowering after mutable places have been marked by the frontend. On IR bodies
 * (docs/design/IR_CORE_COLUMNS.md, migration). The rewrites of a function edit a copy of its body, so the originals a place
 * method clones stay as they were; the helpers it generates are built as functions and encoded.
 */
@:nullSafety(Strict)
class IrValueArrayProgramRewrite {
	/** The types naming an array or an iterator each function has. */
	@:processWide("a contribution memo's key, only ever read")
	public static final ARRAY_TYPES = new compiler.ir.reuse.IrStageMemo.IrContributionKey<Array<Int>>("array-types");

	/**
	 * Discover every concrete value array in the assembled program before generating any helpers. A function that changes becomes
	 * its edited body, owned by the next stage. With `lineage`, each element's rewrite and the allocation lowering reuse what they made
	 * of each function the session has at the same version.
	 */
	public static function rewriteAll(program:IrProgram, pointerBits:Int, target:IrValueLaneTarget,
			?scratch:IrPassScratch, ?lineage:compiler.ir.reuse.IrStageMemo.IrLineage):Void {
		if (scratch == null)
			scratch = new IrPassScratch();
		var builder = scratch.bodyBuilder;
		for (fn in program.functions)
			fn.encodedBody(builder);
		var values:Map<String, Bool> = [for (object in program.objects) if (object.isValue) object.name => true],
			inlineEnums:Map<String, Bool> =
				[for (entry in program.enums) if (entry.inlineStorage != null) entry.name => true],
			elements:Map<String, IrType> = [];
		var seenTags:Map<String, Bool> = [],
			seenEnums:Map<String, Bool> = [],
			seenValues:Map<String, Bool> = [],
			seenOptionalValues:Map<String, Bool> = [];
		function register(element:IrType, seen:Map<String, Bool>, name:String):Void {
			if (seen.exists(name))
				return;
			seen.set(name, true);
			elements.set(haxe.crypto.Base64.encode(compiler.ir.codec.IrTypeCodec.encode(element)), element);
		}
		function visit(type:IrType):Void
			switch type {
				case Array(element):
					switch element {
						case EnumTag(name): register(element, seenTags, name);
						case Enum(name) if (inlineEnums.exists(name)): register(element, seenEnums, name);
						case Obj(name) if (values.exists(name)): register(element, seenValues, name);
						case Nullable(Obj(name)) if (values.exists(name)): register(element, seenOptionalValues, name);
						default:
					}
					visit(element);
				case Nullable(element), Iterator(element):
					visit(element);
				case Function(arguments, result):
					for (argument in arguments)
						visit(argument);
					visit(result);
				default:
			}
		for (object in program.objects)
			for (field in object.fields)
				visit(field.type);
		for (item in program.enums)
			for (constructor in item.cases)
				for (argument in constructor.params)
					visit(argument);
		for (item in program.interfaces)
			for (method in item.methods) {
				for (argument in method.arguments)
					visit(argument);
				visit(method.result);
			}
		for (field in program.staticFields)
			visit(field.type);
		for (native in program.natives) {
			for (argument in native.arguments)
				visit(argument);
			visit(native.result);
		}
		// SSA arguments and definitions cover every operand type, including phi edge uses; each type is visited once. What each
		// function names of them is read once per version in a session (`arrayTypesOf`).
		var visited:Array<Bool> = [];
		for (fn in program.functions)
			for (id in arrayTypesOf(fn, builder, lineage))
				if (id >= visited.length || !visited[id]) {
					while (visited.length <= id)
						visited.push(false);
					visited[id] = true;
					visit(IrTypeIds.type(id));
				}
		var keyed = [for (key => element in elements) {
			key:key, element:element
		}];
		keyed.sort((a, b) -> Reflect.compare(a.key, b.key));
		var index = new ValueArrayFunctionIndex([for (entry in keyed) entry.element], builder),
			slotNamespace = nextSlotNamespace(program),
			declarations:Null<String> = null;
		// What every element's rewrite reads of the value objects, printed once.
		function valueDeclarations():String {
			var known = declarations;
			if (known == null)
				declarations = known = compiler.ir.passes.values.IrInlineValueLayout.valueDeclarations(program.objects);
			return known;
		}
		for (entry in keyed)
			rewriteIndexed(program, entry.element, pointerBits, target, index, slotNamespace++, scratch, lineage,
				valueDeclarations);
		IrArrayFactory.lower(program, scratch, lineage);
		IrVerifier.verifyValueArraysLowered(program, lineage);
		encodeAll(program, index);
	}

	/** The ids of the types `fn`'s arguments, result, rows and descriptors have that name an array or an iterator. */
	static function arrayTypesOf(fn:IrFunction, builder:IrBodyBuilder,
			lineage:Null<compiler.ir.reuse.IrStageMemo.IrLineage>):Array<Int> {
		var version = lineage == null ? 0 : lineage.versionOf(fn);
		if (lineage == null || version == 0)
			return readArrayTypes(fn.encodedBody(builder));
		var memo = lineage.memos.contribution(ARRAY_TYPES), known = memo.get(version);
		if (known == null) {
			known = readArrayTypes(fn.encodedBody(builder));
			memo.keep(version, known);
		} else if (lineage.checks && known.join(",") != readArrayTypes(fn.encodedBody(builder)).join(","))
			throw new InternalError('--check-reuse: the array types reused for ${fn.name} differ from its body');
		return known;
	}

	static function namesArray(type:IrType):Bool
		return switch type {
			case Array(_), Iterator(_): true;
			case Nullable(element): namesArray(element);
			case Function(arguments, result): Lambda.exists(arguments, namesArray) || namesArray(result);
			default: false;
		};

	static function readArrayTypes(body:IrBody):Array<Int> {
		var found:Array<Int> = [];
		function add(id:Int):Void
			if (id >= 0 && found.indexOf(id) < 0 && namesArray(IrTypeIds.type(id)))
				found.push(id);
		for (index in 0...body.argumentCount())
			add(body.valueTypeId(body.argument(index)));
		add(body.result);
		for (block in 0...body.blockCount()) {
			var row = body.firstRow(block);
			while (row >= 0) {
				var output = body.output(row);
				if (output.exists())
					add(body.valueTypeId(output));
				if (body.opcode(row) == IrOpcode.TypeValue)
					add(body.aux(row));
				row = body.nextRow(row);
			}
		}
		return found.length == 0 ? NO_ARRAY_TYPES : found;
	}

	/** The array types of a function that names none, shared. */
	@:processWide("an empty list, only ever read")
	static final NO_ARRAY_TYPES:Array<Int> = [];

	public static function rewrite(program:IrProgram, element:IrType, pointerBits:Int, target:IrValueLaneTarget):Void {
		var scratch = new IrPassScratch();
		var index = new ValueArrayFunctionIndex([element], scratch.bodyBuilder);
		rewriteIndexed(program, element, pointerBits, target, index, nextSlotNamespace(program), scratch);
		encodeAll(program, index);
	}

	/** Every function has its body, the helpers generated here included. */
	static function encodeAll(program:IrProgram, index:ValueArrayFunctionIndex):Void {
		for (fn in program.functions)
			index.bodyOf(fn);
	}

	static function nextSlotNamespace(program:IrProgram):Int {
		var next = 0;
		for (fn in program.functions)
			switch fn.kind {
				case ValueArraySlot(namespace, _, _):
					if (namespace >= next)
						next = namespace + 1;
				default:
			}
		return next;
	}

	/** A fact's value naming `print()` in `lineage`'s session, computed when asked; 0 without a session. */
	static function elementFact(lineage:Null<compiler.ir.reuse.IrStageMemo.IrLineage>, print:() -> String):() -> Int {
		if (lineage == null)
			return () -> 0;
		var facts = lineage.memos.facts;
		return () -> facts.intern(print());
	}

	static function rewriteIndexed(program:IrProgram, element:IrType, pointerBits:Int, target:IrValueLaneTarget,
			index:ValueArrayFunctionIndex, slotNamespace:Int, scratch:IrPassScratch,
			?lineage:compiler.ir.reuse.IrStageMemo.IrLineage, ?valueDeclarations:() -> String):Void {
		switch element {
			case EnumTag(name):
				IrEnumTagStorage.request(program, name);
			default:
		}
		var declarations:Map<String, IrObject> = [for (object in program.objects) object.name => object],
			tagUnboxes:Map<String, IrType> = [],
			objects = IrObjectTable.of(declarations),
			factory = new IrValueArrayFactory(objects, element, pointerBits, target, slotNamespace, program.enums),
			elements = new IrValueArrayElements(element, factory.helpers, factory.bridge),
			methods = new IrValueArrayPlaceMethods(objects, element, factory.helpers),
			originals = index.originalFunctions(program.functions),
			builder = scratch.bodyBuilder,
			uses = scratch.firstInts,
			rewritten:Null<Array<IrFunction>> = null;
		switch element {
			case EnumTag(_):
				for (fn in program.functions)
					switch fn.kind {
						case EnumTagAdapter(type, false): tagUnboxes.set(fn.name, type);
						default:
					}
			default:
		}
		var optional:Null<IrValueArrayOptionalComponents> = switch element {
			case Nullable(Obj(name)) if (declarations.exists(IrOptionalScalarFlow.wrapperName(name))):
				new IrValueArrayOptionalComponents(objects, element, factory.helpers);
			default: null;
		};
		// Each function is rewritten for the element on its own (`ValueArrayElementPass`): one the element's rewrite does not touch
		// is reused unread while its version is the same.
		function rewriteOne(fn:IrFunction):IrFunction {
			var selected = index.has(fn, element),
				current = fn;
			if (selected || index.needsDynamic(fn)) {
				// A copy: the function stays as it was for the place methods that clone it.
				var source = index.bodyOf(fn),
					body = source.frozen ? source.thaw(builder) : IrBodyBuilder.copy(source, builder),
					changed = false;
				if (selected) {
					changed = IrValueArrayRangeRewrite.rewriteBody(body, element, factory, uses) || changed;
					var roots = IrValueArrayPlaceRewrite.bodyRoots(body, element);
					if (roots.keys().hasNext()) {
						IrValueArrayPlaceRewrite.rewriteBody(body, element, objects, factory.helpers, methods, roots);
						changed = true;
					}
					var components = optional;
					if (components != null)
						changed = IrValueArrayOptionalRewrite.rewriteBody(body, element, components, uses) || changed;
					changed = IrValueArrayElementRewrite.rewriteBody(body, element, elements, tagUnboxes, uses)
						|| changed;
				}
				changed = rewriteDynamicViews(body) || changed;
				if (selected) {
					changed = rewriteAllocations(body, element, factory.allocateName()) || changed;
					changed = rewriteCasts(body, element, factory.retypeName()) || changed;
				}
				if (changed)
					current = IrFunction.ofOwnedBody(body);
			}
			index.finish(current);
			return current;
		}
		// What a rewrite and the helpers read of the program besides the function: the element's layout, from the value objects,
		// the enums and the target, and the names it calls by (`IrValueArrayElementPass.ELEMENT`).
		var declarations:() -> String = valueDeclarations
			?? () -> compiler.ir.passes.values.IrInlineValueLayout.valueDeclarations(program.objects);
		function print():String {
			var parts = [
				IrTypeIdentity.text(element),
				'$pointerBits $target $slotNamespace optional ${optional != null}',
				declarations()
			];
			switch element {
				case Enum(name):
					parts.push('storage ${IrTypeIdentity.text(factory.layout.storage)}');
				default:
			}
			var adapters = [for (name in tagUnboxes.keys()) name];
			adapters.sort(Reflect.compare);
			for (name in adapters) {
				var type = tagUnboxes.get(name);
				parts.push('unbox $name ${type == null ? "" : IrTypeIdentity.text(type)}');
			}
			return parts.join("\n");
		}
		var stage = "value-array-rewrite:" + IrTypeIdentity.text(element),
			requests = new IrValueArrayRequests(factory.helpers, methods, elements),
			pass = new ValueArrayElementPass(fn -> index.has(fn, element) || index.needsDynamic(fn), rewriteOne,
				requests,
				elementFact(lineage, print)),
			checks = lineage != null && lineage.checks,
			// The versions of the functions a place method may be specialized from, before the rewrite changes them.
			originalVersions:Map<String, Int> = lineage == null
				? [] : [for (name in originals.keys()) name => lineage.version(name)],
			output = compiler.ir.pipeline.IrFunctionStages.run(stage, pass, program.functions, lineage, checks,
				builder);
		for (position in 0...output.length)
			if (output[position] != program.functions[position]) {
				rewritten = output;
				break;
			}
		var generatedMethods = methods.generate(originals),
			generatedFactories = factory.functions(),
			generatedElements = elements.functions(),
			generatedOptional = optional == null ? [] : optional.functions(),
			generatedSlots = factory.helpers.functions();
		if (rewritten != null)
			program.functions = rewritten;
		var generatedStart = program.functions.length,
			generatedFunctions:Array<IrFunction> = [];
		for (generated in [
			generatedMethods,
			generatedFactories,
			generatedElements,
			generatedOptional,
			generatedSlots
		])
			for (fn in generated) {
				program.functions.push(fn);
				generatedFunctions.push(fn);
			}
		// Resolve only these late producers. Place methods can clone an existing body containing typed requests.
		IrEnumTagLowering.resolveGenerated(program, generatedFunctions);
		IrVerifier.verifyResolvedEnumOperations(program.functions.slice(generatedStart));
		// In a session each helper is derived: last build's while what the element's rewrite reads holds, and for a place method
		// while the function it specializes has the same version.
		if (lineage != null)
			for (position in generatedStart...program.functions.length) {
				var fn = program.functions[position], origin = methods.origins.get(fn.name);
				program.functions[position] = compiler.ir.pipeline.IrFunctionStages.derived(stage, fn.name, pass,
					origin == null
					? compiler.ir.pipeline.IrFunctionStages.FROM_NAME : originalVersions.get(origin) ?? 0,
					lineage, checks, builder, reader -> {
						reader.read(ValueArrayElementPass.ELEMENT, "");
						fn;
					});
			}
		var nullableScalars = false;
		for (slot in factory.layout.lanes.slots)
			if (slot.nullablePayload)
				nullableScalars = true;
		IrValueArrayScalarLowering.rewrite(program, element, target != HashLink || nullableScalars, scratch,
			lineage);
		var nativeNames:Map<String, Bool> = [for (native in program.natives) native.name => true];
		for (native in factory.natives().concat(factory.helpers.natives()).concat(elements.natives()))
			if (!nativeNames.exists(native.name)) {
				nativeNames.set(native.name, true);
				program.natives.push(native);
			}
		// Dynamic views can be introduced after initial assembly; their Wasm dispatch also needs all concrete storage operations.
		IrProgramAssembler.ensureArrayRuntime(program, false, false, false);
		for (native in program.natives)
			nativeNames.set(native.name, true);
		var dynamicNatives:Array<IrNative> = [
			{
				name: "__array_get_any",
				library: "haxeon_runtime",
				symbol: "__array_get_any",
				arguments: [Array(Dyn), I32],
				result: Dyn
			},
			{
				name: "__array_set_any",
				library: "haxeon_runtime",
				symbol: "__array_set_any",
				arguments: [Array(Dyn), I32, Dyn],
				result: Void
			},
			{
				name: "__array_push_any",
				library: "haxeon_runtime",
				symbol: "__array_push_any",
				arguments: [Array(Dyn), Dyn],
				result: I32
			},
			{
				name: "__array_unshift_any",
				library: "haxeon_runtime",
				symbol: "__array_unshift_any",
				arguments: [Array(Dyn), Dyn],
				result: I32
			},
			{
				name: "__array_insert_any",
				library: "haxeon_runtime",
				symbol: "__array_insert_any",
				arguments: [Array(Dyn), I32, Dyn],
				result: Void
			},
			{
				name: "__array_reverse_any",
				library: "haxeon_runtime",
				symbol: "__array_reverse_any",
				arguments: [Array(Dyn)],
				result: Void
			},
			{
				name: "__array_resize_any",
				library: "haxeon_runtime",
				symbol: "__array_resize_any",
				arguments: [Array(Dyn), I32],
				result: Void
			},
			{
				name: "__array_copy_any",
				library: "haxeon_runtime",
				symbol: "__array_copy_any",
				arguments: [Array(Dyn)],
				result: Array(Dyn)
			},
			{
				name: "__array_slice_any",
				library: "haxeon_runtime",
				symbol: "__array_slice_any",
				arguments: [Array(Dyn), I32, I32],
				result: Array(Dyn)
			},
			{
				name: "__array_splice_any",
				library: "haxeon_runtime",
				symbol: "__array_splice_any",
				arguments: [Array(Dyn), I32, I32],
				result: Array(Dyn)
			},
			{
				name: "__array_concat_any",
				library: "haxeon_runtime",
				symbol: "__array_concat_any",
				arguments: [Array(Dyn), Array(Dyn)],
				result: Array(Dyn)
			},
			{
				name: "__array_pop_any",
				library: "haxeon_runtime",
				symbol: "__array_pop_any",
				arguments: [Array(Dyn)],
				result: Dyn
			},
			{
				name: "__array_shift_any",
				library: "haxeon_runtime",
				symbol: "__array_shift_any",
				arguments: [Array(Dyn)],
				result: Dyn
			},
			{
				name: "__array_remove_at_any",
				library: "haxeon_runtime",
				symbol: "__array_remove_at_any",
				arguments: [Array(Dyn), I32],
				result: Void
			}
		];
		for (native in dynamicNatives)
			if (!nativeNames.exists(native.name)) {
				nativeNames.set(native.name, true);
				program.natives.push(native);
			}
	}

	/** A checked concrete view must install the lane representation on the shared dynamic header. */
	static function rewriteCasts(body:IrBody, element:IrType, retype:String):Bool {
		var arrayType = body.typeId(Array(element)), dyn = body.typeId(Dyn), changed = false;
		for (block in 0...body.blockCount()) {
			var row = body.firstRow(block);
			while (row >= 0) {
				if (body.opcode(row) == IrOpcode.SafeCast && IrValueArrayRows.typed(body, body.output(row), arrayType)
					&& IrValueArrayRows.typed(body, body.operand(row, 0), dyn)) {
					changed = true;
					var dynamicView = body.newValue("$value-array-dynamic-view", body.typeId(Array(Dyn)));
					body.beginRow();
					body.pushOperand(body.operand(row, 0));
					body.linkBefore(block, row, body.endRow(IrOpcode.SafeCast, dynamicView, 0, body.provenance(row)));
					body.setOperation(row, IrOpcode.Call, IrSymbol.of(retype).id);
					body.setOperand(row, 0, dynamicView);
				}
				row = body.nextRow(row);
			}
		}
		return changed;
	}

	/** A shared classifier keeps the index and actual rewrite in agreement; `arrayDyn` and `dyn` are the body's type ids. */
	public static function dynamicViewKind(body:IrBody, row:Int, arrayDyn:Int, dyn:Int):Int {
		return switch body.opcode(row) {
			case IrOpcode.ArrayGet if (IrValueArrayRows.typed(body, body.operand(row, 0), arrayDyn)
				&& IrValueArrayRows.typed(body, body.output(row), dyn)): 1;
			case IrOpcode.ArraySet if (IrValueArrayRows.typed(body, body.operand(row, 0), arrayDyn)
				&& IrValueArrayRows.typed(body, body.operand(row, 2), dyn)): 2;
			case IrOpcode.Call if (body.operandCount(row) > 0
				&& IrValueArrayRows.typed(body, body.operand(row, 0), arrayDyn)):
				switch body.symbol(row).name {
					case "__array_push_ref" | "__array_unshift_ref" | "__array_insert_ref" | "__array_reverse_ref"
						| "__array_resize_ref" | "__array_copy_ref" | "__array_slice_ref" | "__array_splice_ref"
						| "__array_concat_ref" | "__array_pop_ref" | "__array_shift_ref" | "__array_index_of_ref"
						| "__array_remove_ref": 3;
					default: 0;
				}
			default: 0;
		};
	}

	/** Dynamic views dispatch by runtime storage. */
	static function rewriteDynamicViews(body:IrBody):Bool {
		var arrayDyn = body.typeId(Array(Dyn)), dyn = body.typeId(Dyn), changed = false;
		for (block in 0...body.blockCount()) {
			var row = body.firstRow(block);
			while (row >= 0) {
				var following = body.nextRow(row);
				switch dynamicViewKind(body, row, arrayDyn, dyn) {
					case 1:
						body.setOperation(row, IrOpcode.Call, IrSymbol.of("__array_get_any").id);
						changed = true;
					case 2:
						IrValueArrayRows.replaceByCall(body, block, row,
							body.newValue("$dynamic-array-write", body.typeId(Void)), "__array_set_any");
						changed = true;
					case 3:
						var name = body.symbol(row).name;
						body.setAux(row, IrSymbol.of(name.substr(0, name.length - 3) + "any").id);
						changed = true;
					default:
				}
				row = following;
			}
		}
		return changed;
	}

	static function rewriteAllocations(body:IrBody, element:IrType, allocator:String):Bool {
		var arrayType:IrType = Array(element), changed = false;
		for (block in 0...body.blockCount()) {
			var row = body.firstRow(block);
			while (row >= 0) {
				if (body.opcode(row) == IrOpcode.Call) {
					var name = body.symbol(row).name;
					if ((name == IrArrayFactory.NAME || name == "__array_alloc_ref")
						&& IrVerifier.sameType(body.valueType(body.output(row)), arrayType)) {
						if (body.operandCount(row) != 1)
							throw new InternalError("Invalid array factory arguments");
						body.setAux(row, IrSymbol.of(allocator).id);
						changed = true;
					}
				}
				row = body.nextRow(row);
			}
		}
		return changed;
	}
}

/**
 * One element's rewrite of the value arrays per function (`IrFunctionPass`): a function the rewrite selects (`gate`: it names an
 * array of the element, or has a dynamic view left) reads what the rewrite reads of the program as one fact (`ELEMENT`: the
 * element's layout, from the value objects, the enums and the target), and asks for the helpers it calls through the element's
 * registries (`IrValueArrayRequests`); any other is left as it is, and reused unread at the same version.
 */
@:nullSafety(Strict)
private class ValueArrayElementPass implements compiler.ir.pipeline.IrFunctionPass {
	public static inline final ELEMENT = 0;

	final gate:IrFunction->Bool;
	final rewrite:IrFunction->IrFunction;
	final requests:IrValueArrayRequests;
	final element:() -> Int;

	public function new(gate:IrFunction->Bool, rewrite:IrFunction->IrFunction, requests:IrValueArrayRequests,
			element:() -> Int) {
		this.gate = gate;
		this.rewrite = rewrite;
		this.requests = requests;
		this.element = element;
	}

	public function summarize(fn:IrFunction):Int
		return 0;

	public function prepare(functions:Array<IrFunction>, summaries:Array<Int>,
			names:compiler.ir.pipeline.IrFunctionIndex):Void {}

	public function fact(kind:Int, key:String):Int
		return element();

	public function transform(fn:IrFunction, summary:Int, reader:compiler.ir.reuse.IrFactReader):IrFunction {
		if (!gate(fn))
			return fn;
		reader.read(ELEMENT, "");
		requests.reader = reader;
		var result = rewrite(fn);
		requests.reader = null;
		return result;
	}

	public function request(kind:Int, type:IrType, name:Null<String>):Void
		requests.replay(kind, type, name ?? "");

	public function finish(functions:Array<IrFunction>):Array<IrFunction>
		return functions;
}

/**
 * The helpers a value array rewrite asks the element's registries for (the place checks, the place methods and accessors, the
 * iterator), recorded as requests while a memoized rewrite runs, so a function reused unread asks for them again (`replay`).
 */
@:nullSafety(Strict)
class IrValueArrayRequests {
	static inline final CHECK = 0;
	static inline final CHECK_SELF = 1;
	static inline final METHOD = 2;
	static inline final VALUE_SETTER = 3;
	static inline final SCALAR_GETTER = 4;
	static inline final ITERATOR = 5;

	final helpers:IrValueArraySlotHelpers;
	final methods:IrValueArrayPlaceMethods;
	final elements:IrValueArrayElements;

	/** The reader of the rewrite running, or null. */
	public var reader:Null<compiler.ir.reuse.IrFactReader> = null;

	var replaying = false;

	public function new(helpers:IrValueArraySlotHelpers, methods:IrValueArrayPlaceMethods,
			elements:IrValueArrayElements) {
		this.helpers = helpers;
		this.methods = methods;
		this.elements = elements;
		helpers.observer = this;
		methods.observer = this;
		elements.observer = this;
	}

	function note(kind:Int, type:IrType, name:String):Void {
		var current = reader;
		if (current != null && !replaying)
			current.request(kind, type, name);
	}

	public function check(path:Array<String>, includeSelf:Bool):Void
		note(includeSelf ? CHECK_SELF : CHECK, Void, text(path));

	public function method(receiverType:IrType, method:String, path:Array<String>):Void
		note(METHOD, receiverType, method + "\u0002" + text(path));

	public function valueSetter(type:IrType, path:Array<String>):Void
		note(VALUE_SETTER, type, text(path));

	public function scalarGetter(type:IrType, path:Array<String>):Void
		note(SCALAR_GETTER, type, text(path));

	public function iterator():Void
		note(ITERATOR, Void, "");

	/** Asks the registries for what a request recorded (`note`). */
	public function replay(kind:Int, type:IrType, name:String):Void {
		replaying = true;
		switch kind {
			case CHECK, CHECK_SELF:
				helpers.checker(path(name), kind == CHECK_SELF);
			case METHOD:
				var split = name.indexOf("\u0002");
				methods.method(type, name.substr(0, split), path(name.substr(split + 1)));
			case VALUE_SETTER:
				methods.valueSetter(type, path(name));
			case SCALAR_GETTER:
				methods.scalarGetter(type, path(name));
			case _:
				elements.useIterator();
		}
		replaying = false;
	}

	/** A field path as a request's name spells it: field names never hold a control character. */
	static function text(path:Array<String>):String
		return path.join("\u0001");

	static function path(text:String):Array<String>
		return text == "" ? [] : text.split("\u0001");
}
