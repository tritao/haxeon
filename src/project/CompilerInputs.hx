package project;

import build.Target;
import build.TargetLayout;

/** A source root whose files belong to a package: `X.hx` directly under it is the module `<packageName>.X`. */
typedef PackageSourceRoot = {
	final packageName:String;
	final path:String;
}

/** One FFI import of a package, as an earlier build action generates it under the build layout. */
typedef GeneratedFfiInputs = {
	final interfacePath:String;

	/** The generated projection's source root and the manifest listing its sources; null for an import without a projection. */
	final projectionRoot:Null<String>;

	final projectionManifest:Null<String>;
}

/**
 * What a resolved project gives the compiler, worked out in one place for every consumer: the build renders it as compiler
 * arguments (`build.provider.CompilerProvider`), the language server configures its compiler with it
 * (`editor.lsp.ProjectWorkspace`), and the Android asset build loads it (`tools.AndroidBuild`).
 */
class CompilerInputs {
	/** The compiler's target name (`--target`): `wasm32` for a Wasm build target, otherwise `hl`. */
	public final target:String;

	public final entry:Null<String>;

	/** The packages' source roots, in package order. */
	public final roots:Array<String>;

	/** The source roots whose files belong to their package (`scopeSourceRoots`). */
	public final packageRoots:Array<PackageSourceRoot>;

	/** The packages' source files, sorted. */
	public final sources:Array<String>;

	/** Checked-in FFI interfaces and projections, in package order. */
	public final ffiInterfaces:Array<String>;

	public final ffiProjections:Array<String>;

	/** FFI imports, generated by the build before it compiles; the language server reads those an earlier build left. */
	public final generatedFfi:Array<GeneratedFfiInputs>;

	/** The manifest's defines, after `android` for an Android build. */
	public final defines:Array<String>;

	/** False when the manifest turns inlining off (`"inline": false`). */
	public final inlineEnabled:Bool;

	function new(target:String, entry:Null<String>, roots:Array<String>, packageRoots:Array<PackageSourceRoot>,
			sources:Array<String>, ffiInterfaces:Array<String>, ffiProjections:Array<String>,
			generatedFfi:Array<GeneratedFfiInputs>, defines:Array<String>, inlineEnabled:Bool) {
		this.target = target;
		this.entry = entry;
		this.roots = roots;
		this.packageRoots = packageRoots;
		this.sources = sources;
		this.ffiInterfaces = ffiInterfaces;
		this.ffiProjections = ffiProjections;
		this.generatedFfi = generatedFfi;
		this.defines = defines;
		this.inlineEnabled = inlineEnabled;
	}

	/** The compiler inputs of `project` built for `layout`'s target, with generated files at `layout`'s paths. */
	public static function of(project:ResolvedProject, layout:TargetLayout):CompilerInputs {
		var buildTarget = layout.target(),
			entry = project.manifest.entry,
			roots:Array<String> = [],
			packageRoots:Array<PackageSourceRoot> = [],
			sources:Array<String> = [],
			ffiInterfaces:Array<String> = [],
			ffiProjections:Array<String> = [],
			generatedFfi:Array<GeneratedFfiInputs> = [];
		for (resolvedPackage in project.packages.packages) {
			for (sourceRoot in resolvedPackage.sourceRoots)
				roots.push(sourceRoot);
			// A dependency's files belong to its package; the root package's do only when the entry is one of them.
			var scoped = resolvedPackage.manifest.scopeSourceRoots
				&& (resolvedPackage.name != project.rootPackage.name
				|| entry == resolvedPackage.name
				|| (entry != null && StringTools.startsWith(entry, resolvedPackage.name + ".")));
			if (scoped)
				for (sourceRoot in resolvedPackage.sourceRoots)
					if (resolvedPackage.unscopedSourceRoots.indexOf(sourceRoot) < 0)
						packageRoots.push({packageName: resolvedPackage.name, path: sourceRoot});
			for (source in resolvedPackage.sources)
				sources.push(source);
			for (projection in resolvedPackage.ffiProjections)
				ffiProjections.push(projection);
			for (interfacePath in resolvedPackage.ffiInterfaces)
				ffiInterfaces.push(interfacePath);
		}
		for (resolvedPackage in project.packages.packages)
			for (ffi in resolvedPackage.ffiImports) {
				var name = ffi.config.name;
				generatedFfi.push({
					interfacePath: layout.ffiInterfacePath(resolvedPackage.name, name),
					projectionRoot: ffi.config.projection ? layout.ffiProjectionPath(resolvedPackage.name, name) : null,
					projectionManifest: ffi.config.projection ? layout.ffiProjectionManifestPath(resolvedPackage.name,
						name) : null
				});
			}
		sources.sort(Reflect.compare);
		var defines = buildTarget.isAndroid() ? ["android"] : [];
		for (define in project.manifest.defines)
			defines.push(define);
		return new CompilerInputs(compilerTarget(buildTarget), entry, roots, packageRoots, sources, ffiInterfaces,
			ffiProjections, generatedFfi, defines, project.manifest.inlineEnabled != false);
	}

	/** The compiler's name for what a build target runs: Wasm modules for a Wasm target, HashLink code otherwise. */
	public static function compilerTarget(target:Target):String
		return target.isWasm() ? "wasm32" : "hl";
}
